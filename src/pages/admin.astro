---
// Private portfolio manager (/admin/). Static page: holds no credentials. Marwen signs in with a
// fine-grained GitHub token (this repository only, Contents: read & write) that stays in his browser
// and is sent only to api.github.com. GitHub itself enforces write access; the page also refuses any
// account other than the owner. Save & Publish writes images + src/data/portfolio.json as ONE commit
// on main (fast-forward only), and GitHub Actions redeploys the site.
import '@fontsource/argentum-sans/latin-400.css';
import '@fontsource/argentum-sans/latin-800.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { portfolioData } from '../data/portfolio';
import { alts } from '../data/portfolio-alts';

// Build-time thumbnails of every board and video thumbnail (lists show the first one, the Selected Work
// manager all of them). Projects added since the last deploy fall back to the repository file, and so do
// hidden projects, so the built site carries no images of them.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio/*/{d,v}-*.{webp,jpg}', { eager: true });
const thumbs: Record<string, string> = {};
const covers = new Map<string, string[]>(); // project id → its Selected-Work-only video thumbnails
for (const g of portfolioData.featured ?? []) for (const it of g.items) covers.set(it.project, [...(covers.get(it.project) ?? []), ...Object.values(it.covers ?? {})]);
for (const [id, p] of Object.entries(portfolioData.projects)) {
  if (p.hidden) continue;
  for (const b of [...p.boards, ...(p.videos ?? []).flatMap((v) => (v.thumb ? [v.thumb] : [])), ...(covers.get(id) ?? [])]) {
    const key = `${p.folder}/${b}`;
    const file = files[`../assets/portfolio/${key}`];
    if (file) thumbs[key] = (await getImage({ src: file.default, width: 240, format: 'webp', quality: 70 })).src;
  }
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Portfolio manager</title>
  </head>
  <body>
    <script type="application/json" id="thumbs" set:html={JSON.stringify(thumbs)} />
    <!-- Ids with written alt texts (portfolio-alts.ts): a new project never takes one of them, so a
         deleted project's texts can never attach to a new project's boards -->
    <script type="application/json" id="reserved" set:html={JSON.stringify(Object.keys(alts))} />

    <header class="bar">
      <p class="brand">Portfolio <span>manager</span></p>
      <p class="who" data-who hidden><span data-login></span> · <button type="button" class="link" data-signout>Sign out</button></p>
    </header>

    <main class="wrap">
      <!-- Sign in -->
      <section class="panel" data-signin>
        <h1>Sign in</h1>
        <p class="hint">
          Paste a GitHub <strong>fine-grained personal access token</strong> created on the
          <code>marwendrididesigner</code> account with access to <strong>only</strong> the
          <code>portfolio</code> repository and the permission <strong>Contents: Read and write</strong>.
          <a href="https://github.com/settings/personal-access-tokens/new" target="_blank" rel="noopener noreferrer">Create a token ↗</a>
        </p>
        <form data-signin-form>
          <label>Access token <input type="password" name="token" autocomplete="off" spellcheck="false" required /></label>
          <label class="check"><input type="checkbox" name="remember" /> Remember on this device</label>
          <button class="btn btn--primary" type="submit">Sign in</button>
        </form>
        <p class="msg" data-signin-msg role="status"></p>
      </section>

      <!-- Manager -->
      <section data-manager hidden>
        <nav class="tabs" aria-label="Manager sections">
          <button type="button" class="tab" data-tab="projects" aria-pressed="true">All Projects</button>
          <button type="button" class="tab" data-tab="featured" aria-pressed="false">Selected Work</button>
        </nav>

        <div data-pane="projects">
        <div class="tools">
          <label class="cat">Category
            <select data-category></select>
          </label>
          <button type="button" class="btn btn--ghost" data-add>+ Add project</button>
        </div>

        <ol class="list" data-list aria-label="Projects in this category"></ol>

        <!-- Add project -->
        <form class="panel add" data-add-form hidden>
          <h2>New project</h2>
          <div class="grid">
            <label>Project name <input name="name" maxlength="80" required /></label>
            <label>Category <select name="chapter" data-add-chapter></select></label>
            <label>Country <input name="country" maxlength="40" /></label>
          </div>
          <label class="files">Presentation boards (JPG, PNG or WebP · max 25 MB each · in display order · optional for video projects)
            <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-files />
          </label>
          <ol class="boards" data-boards aria-label="Boards of the new project"></ol>
          <h3 class="bm-h">Videos (Google Drive)</h3>
          <p class="hint">For Motion Design &amp; Video Editing. Paste each video’s Google Drive link (sharing: “Anyone with the link · Viewer”). Videos are never uploaded to GitHub — only the link and an optimized thumbnail.</p>
          <div data-add-videos></div>
          <p class="msg" data-add-msg role="status"></p>
          <div class="row">
            <button class="btn btn--primary" type="submit">Add to category</button>
            <button class="btn btn--ghost" type="button" data-add-cancel>Cancel</button>
          </div>
        </form>
        </div>

        <!-- Selected Work: four fixed groups, up to four projects each -->
        <div data-pane="featured" hidden>
          <p class="hint">The <strong>Selected Work</strong> section above the full portfolio: up to 4 projects per group, each with the boards you select, in your order. Changes here never alter the full portfolio. Empty slots are not shown on the website.</p>
          <div data-featured></div>
        </div>

        <!-- Project picker (Add / Change Project) -->
        <dialog class="picker" data-picker aria-labelledby="picker-title">
          <div class="picker-head">
            <h2 id="picker-title" data-picker-title>Choose a project</h2>
            <button type="button" class="mini" data-picker-close aria-label="Close">✕</button>
          </div>
          <input type="search" placeholder="Search projects…" data-picker-search aria-label="Search projects" />
          <label class="check"><input type="checkbox" data-picker-all /> Show projects from all categories</label>
          <ol class="plist" data-picker-list></ol>
        </dialog>

        <!-- Featured boards manager -->
        <dialog class="picker picker--wide" data-bm aria-labelledby="bm-title">
          <div class="picker-head">
            <h2 id="bm-title" data-bm-title>Featured media</h2>
            <button type="button" class="mini" data-bm-cancel aria-label="Cancel">✕</button>
          </div>
          <div class="bm-body">
            <p class="hint">Tick the boards and videos to show in Selected Work, then set their order below. The full portfolio keeps showing everything.</p>
            <div data-bm-boards>
              <h3 class="bm-h">All boards</h3>
              <ol class="covers" data-bm-all></ol>
              <h3 class="bm-h" data-bm-count>Selected boards</h3>
              <ol class="list" data-bm-sel></ol>
            </div>
            <div data-bmv>
              <h3 class="bm-h">All videos</h3>
              <ol class="covers" data-bmv-all></ol>
              <h3 class="bm-h" data-bmv-count>Selected videos</h3>
              <p class="hint">A Selected Work thumbnail is optional: it replaces the video’s own thumbnail in Selected Work only.</p>
              <ol class="list" data-bmv-sel></ol>
              <input type="file" accept="image/jpeg,image/png,image/webp" data-bmv-cover hidden />
            </div>
          </div>
          <p class="msg err" data-bm-msg role="status"></p>
          <div class="row bm-foot">
            <button type="button" class="btn btn--primary" data-bm-done>Done</button>
            <button type="button" class="btn btn--ghost" data-bm-cancel>Cancel</button>
          </div>
        </dialog>

        <!-- Edit project: details + boards (id, category and project order are untouched) -->
        <dialog class="picker picker--wide" data-ed aria-labelledby="ed-title">
          <div class="picker-head">
            <h2 id="ed-title" data-ed-title>Edit project</h2>
            <button type="button" class="mini" data-ed-cancel aria-label="Cancel">✕</button>
          </div>
          <form class="ed-form" data-ed-form>
            <div class="bm-body">
              <h3 class="bm-h">Project details</h3>
              <div class="ed-grid">
                <label class="ed-wide">Project section <select name="chapter" data-ed-chapter></select></label>
                <label>Project name <input name="client" maxlength="80" /></label>
                <label>Project title <input name="title" maxlength="120" /></label>
                <label>Country <input name="country" maxlength="40" /></label>
                <label>Services (separate with “ · ”) <input name="services" maxlength="160" /></label>
              </div>
              <h3 class="bm-h" data-eb-count>Manage boards</h3>
              <p class="hint">Display order on the website. Drag a board to move it, or use ↑ ↓. Replacing keeps the board’s position.</p>
              <ol class="boards eb" data-eb aria-label="Boards of this project"></ol>
              <h3 class="bm-h">Add new boards</h3>
              <label class="files">JPG, PNG or WebP · max 25 MB each · added at the end
                <input type="file" accept="image/jpeg,image/png,image/webp" multiple data-eb-add />
              </label>
              <input type="file" accept="image/jpeg,image/png,image/webp" data-eb-replace hidden />
              <h3 class="bm-h" data-ev-count>Videos &amp; thumbnails</h3>
              <p class="hint">Google Drive videos, shown after the boards in this order. Share each video as “Anyone with the link · Viewer”. Thumbnails: JPG, PNG or WebP, optimized to WebP in your browser; without one the website shows a placeholder. Replacing a link or thumbnail keeps the video’s place, including in Selected Work.</p>
              <div data-ev></div>
            </div>
            <p class="msg err" data-ed-msg role="status"></p>
            <div class="row bm-foot">
              <button class="btn btn--primary" type="submit">Save changes</button>
              <button class="btn btn--ghost" type="button" data-ed-cancel>Cancel</button>
            </div>
          </form>
        </dialog>

        <!-- Delete project: explicit confirmation (type DELETE) -->
        <dialog class="picker" data-del aria-labelledby="del-title">
          <div class="picker-head">
            <h2 id="del-title">Delete project permanently?</h2>
            <button type="button" class="mini" data-del-cancel aria-label="Cancel">✕</button>
          </div>
          <form class="ed-form" data-del-form>
            <div class="bm-body">
              <p class="name del-name" data-del-name></p>
              <p class="hint">This is <strong>permanent</strong>. After Save &amp; Publish the project, its details and its boards are removed from the portfolio and from both the English and French websites. It cannot be restored from this dashboard. To take it off the website but keep it, use <strong>Hide</strong> instead.</p>
              <h3 class="bm-h">Also removed</h3>
              <ul class="del-refs" data-del-refs></ul>
              <p class="hint">Its board images are deleted from GitHub only once the new website is live, and only images no other project uses.</p>
              <label>Type DELETE to confirm <input name="confirm" autocomplete="off" spellcheck="false" data-del-input /></label>
            </div>
            <div class="row bm-foot">
              <button class="btn btn--danger" type="submit" data-del-ok disabled>Delete project</button>
              <button class="btn btn--ghost" type="button" data-del-cancel>Cancel</button>
            </div>
          </form>
        </dialog>

        <div class="publish">
          <p class="msg" data-status role="status" aria-live="polite"></p>
          <button type="button" class="btn btn--primary" data-publish disabled>Save &amp; Publish</button>
        </div>
      </section>
    </main>

    <script>
      import { driveId, drivePreview, driveView, RATIOS, ratioValue, type Ratio } from '../data/drive';
      const OWNER = 'marwendrididesigner';
      const REPO = 'portfolio';
      const BRANCH = 'main';
      const DATA_PATH = 'src/data/portfolio.json';
      const ASSET_DIR = 'src/assets/portfolio';
      const MAX_BYTES = 25 * 1024 * 1024;
      const MAX_BOARDS = 12;
      const MAX_EDGE = 2400; // same as the existing web masters
      const TYPES = ['image/jpeg', 'image/png', 'image/webp'];
      const KEY = 'portfolio-admin-token';

      // Videos: Google Drive links; `id` is permanent, `thumb` a v-* file in the project folder (null = placeholder)
      type SVideo = { id: string; url: string; title: string | null; ratio: Ratio; thumb: string | null };
      type Stored = { client: string | null; title: string | null; country: string | null; services: string | null; folder: string; boards: string[]; videos?: SVideo[]; hidden?: boolean };
      // boards / videos: the selection, in display order; covers: Selected-Work-only video thumbnails (video id → file)
      type Item = { project: string; boards: string[]; videos?: string[]; covers?: Record<string, string> };
      type Group = { id: string; title: string; chapter: string; chapters: string[]; items: Item[] };
      type Data = { chapters: { id: string; title: string; projects: string[] }[]; projects: Record<string, Stored>; featured?: Group[] };
      const MAX_FEATURED = 4;
      type Board = { blob: Blob; ext: 'webp' | 'jpg'; url: string; name: string; hash: string; w: number; h: number }; // hash: of the chosen file, to catch duplicates
      const THUMB_EDGE = 1920; // video thumbnails: never shown larger than a half-width card

      const $ = <T extends Element>(s: string) => document.querySelector<T>(s)!;
      const thumbs: Record<string, string> = JSON.parse($('#thumbs').textContent || '{}');
      const reserved = new Set<string>(JSON.parse($('#reserved').textContent || '[]'));
      const el = (tag: string, cls?: string, text?: string) => {
        const e = document.createElement(tag);
        if (cls) e.className = cls;
        if (text !== undefined) e.textContent = text;
        return e;
      };
      const store = {
        get: () => { try { return sessionStorage.getItem(KEY) ?? localStorage.getItem(KEY); } catch { return null; } },
        set: (t: string, remember: boolean) => { try { (remember ? localStorage : sessionStorage).setItem(KEY, t); } catch {} },
        clear: () => { try { sessionStorage.removeItem(KEY); localStorage.removeItem(KEY); } catch {} },
      };

      let token = '';
      let data: Data;
      let dataSha = '';          // blob sha of portfolio.json when loaded — publish refuses if it changed
      // Board files are keyed "<folder>/<file name>". A board's file name is its permanent id: new and
      // replacement boards always get a new, unused name, so nothing published is ever overwritten.
      let uploads = new Map<string, Board>(); // files to upload on the next publish (new projects + board edits)
      const previews = new Map<string, string>(); // local previews of files published from this page
      const inRepo = new Set<string>();      // board files known to exist on GitHub
      const toDelete = new Set<string>();    // removed/replaced files, deleted once the new site is live
      const added = new Set<string>();       // new project ids (not published yet)
      const boardsChanged = new Set<string>(); // existing projects whose boards were edited
      const videosChanged = new Set<string>(); // existing projects whose videos were edited
      let dirty = false;
      let featuredChanged = false;
      let detailsChanged = false;
      const moved = new Map<string, string>(); // project id → its section when first moved (not published yet)
      const isMoved = (id: string) => moved.has(id) && !added.has(id) && chapterOf(id)?.id !== moved.get(id);
      // Hidden: `hidden: true` in portfolio.json (absent = visible). The project keeps its place in its
      // section and in Selected Work, so un-hiding restores it exactly.
      const wasHidden = new Set<string>(); // hidden on GitHub when loaded / last published
      const visChanged = (id: string) => !added.has(id) && !!data.projects[id]!.hidden !== wasHidden.has(id);
      const deleted = new Map<string, string>(); // deleted published project id → its name (for the commit message)
      let busy = false;
      let draft: Board[] = [];
      // Chapter-order snapshot, so the commit message says whether the project order changed
      const order = () => JSON.stringify(data.chapters.map((c) => c.projects));
      let loadedOrder = '';

      // ---- GitHub API -------------------------------------------------------------------------
      async function gh(path: string, init: RequestInit = {}) {
        const res = await fetch(`https://api.github.com${path}`, {
          ...init,
          cache: 'no-store',
          headers: {
            Accept: 'application/vnd.github+json',
            Authorization: `Bearer ${token}`,
            'X-GitHub-Api-Version': '2022-11-28',
            ...(init.body ? { 'Content-Type': 'application/json' } : {}),
          },
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          const err = new Error(body.message || `GitHub error ${res.status}`) as Error & { status: number };
          err.status = res.status;
          throw err;
        }
        return res.status === 204 ? null : res.json();
      }
      const repo = (p: string) => `/repos/${OWNER}/${REPO}${p}`;
      const b64ToText = (b64: string) => new TextDecoder().decode(Uint8Array.from(atob(b64.replace(/\n/g, '')), (c) => c.charCodeAt(0)));
      const blobToB64 = (blob: Blob) => new Promise<string>((ok, fail) => {
        const r = new FileReader();
        r.onload = () => ok(String(r.result).split(',')[1]!);
        r.onerror = () => fail(r.error);
        r.readAsDataURL(blob);
      });

      async function loadData() {
        const f = await gh(repo(`/contents/${DATA_PATH}?ref=${BRANCH}`));
        data = JSON.parse(b64ToText(f.content));
        dataSha = f.sha;
        loadedOrder = order();
        for (const [id, p] of Object.entries(data.projects)) if (p.hidden) wasHidden.add(id);
        for (const k of referenced(data)) inRepo.add(k);
      }
      // Every image file the data uses: boards, video thumbnails and Selected Work thumbnails
      const referenced = (d: Data) => new Set([
        ...Object.values(d.projects).flatMap((p) => [...p.boards, ...(p.videos ?? []).flatMap((v) => (v.thumb ? [v.thumb] : []))].map((b) => `${p.folder}/${b}`)),
        ...(d.featured ?? []).flatMap((g) => g.items.flatMap((it) => Object.values(it.covers ?? {}).map((f) => `${d.projects[it.project]?.folder}/${f}`))),
      ]);
      // File names in one repository folder (empty for a folder that does not exist yet)
      async function listFolder(folder: string, ref: string) {
        try {
          const items: { name: string }[] = await gh(repo(`/contents/${ASSET_DIR}/${folder}?ref=${ref}`));
          return new Set(items.map((x) => x.name));
        } catch (e) {
          if ((e as { status?: number }).status === 404) return new Set<string>();
          throw e;
        }
      }

      // ---- Sign in ----------------------------------------------------------------------------
      async function signIn(t: string, remember: boolean | null) {
        const msg = $<HTMLElement>('[data-signin-msg]');
        token = t.trim();
        msg.textContent = 'Checking…';
        try {
          const user = await gh('/user');
          if (String(user.login).toLowerCase() !== OWNER) throw new Error(`This token belongs to “${user.login}”. Only ${OWNER} can manage the portfolio.`);
          await loadData();
          if (remember !== null) store.set(token, remember);
          msg.textContent = '';
          $<HTMLElement>('[data-login]').textContent = user.login;
          $<HTMLElement>('[data-who]').hidden = false;
          $<HTMLElement>('[data-signin]').hidden = true;
          $<HTMLElement>('[data-manager]').hidden = false;
          fillCategories();
          render();
        } catch (e) {
          token = '';
          store.clear();
          const err = e as Error & { status?: number };
          msg.textContent = err.status === 401 ? 'GitHub rejected this token (expired or mistyped).'
            : err.status === 404 || err.status === 403 ? 'This token cannot read the portfolio repository. Give it access to the “portfolio” repository with Contents: Read and write.'
            : err.message;
        }
      }
      $<HTMLFormElement>('[data-signin-form]').addEventListener('submit', (e) => {
        e.preventDefault();
        const f = e.target as HTMLFormElement;
        signIn((f.elements.namedItem('token') as HTMLInputElement).value, (f.elements.namedItem('remember') as HTMLInputElement).checked);
        f.reset();
      });
      $('[data-signout]').addEventListener('click', () => {
        if (dirty && !confirm('You have unpublished changes. Sign out anyway?')) return;
        store.clear();
        location.reload();
      });

      // ---- Category list ----------------------------------------------------------------------
      const catSelect = $<HTMLSelectElement>('[data-category]');
      function fillCategories() {
        for (const sel of [catSelect, $<HTMLSelectElement>('[data-add-chapter]'), $<HTMLSelectElement>('[data-ed-chapter]')]) {
          sel.replaceChildren(...data.chapters.map((c, i) => {
            const o = el('option', undefined, `${String(i + 1).padStart(2, '0')} · ${c.title}`) as HTMLOptionElement;
            o.value = c.id;
            return o;
          }));
        }
      }
      catSelect.addEventListener('change', render);
      const current = () => data.chapters.find((c) => c.id === catSelect.value)!;

      // Video without a thumbnail (same look as the website placeholder)
      const PLACEHOLDER = `data:image/svg+xml,${encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 160 90"><rect width="160" height="90" fill="#020a22"/><circle cx="80" cy="45" r="16" fill="#000004" stroke="#fff5ea" stroke-opacity=".35"/><path d="M75 37v16l13-8z" fill="#fff5ea"/></svg>')}`;
      const fileUrl = (folder: string, file: string) => {
        const key = `${folder}/${file}`;
        return uploads.get(key)?.url ?? previews.get(key) ?? thumbs[key]
          ?? `https://raw.githubusercontent.com/${OWNER}/${REPO}/${BRANCH}/${ASSET_DIR}/${key}`;
      };
      // A board (or, without one, the project's first board → first video thumbnail → placeholder)
      function thumbFor(id: string, board?: string) {
        const p = data.projects[id]!;
        const f = board ?? p.boards[0] ?? p.videos?.find((v) => v.thumb)?.thumb;
        return f ? fileUrl(p.folder, f) : PLACEHOLDER;
      }
      const videoThumb = (id: string, vid: string) => {
        const p = data.projects[id]!, v = p.videos?.find((x) => x.id === vid);
        return v?.thumb ? fileUrl(p.folder, v.thumb) : PLACEHOLDER;
      };
      const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
      const mediaText = (p: Stored) => [p.boards.length && plural(p.boards.length, 'board'), p.videos?.length && plural(p.videos.length, 'video')].filter(Boolean).join(' · ') || 'no media';

      function render() {
        const list = $<HTMLOListElement>('[data-list]');
        const ids = current().projects;
        list.replaceChildren(...ids.map((id, i) => {
          const p = data.projects[id]!;
          const li = el('li', ['item', added.has(id) && 'is-new', p.hidden && 'is-hidden'].filter(Boolean).join(' '));
          const img = el('img') as HTMLImageElement;
          img.src = thumbFor(id); img.alt = ''; img.loading = 'lazy'; img.width = 96; img.height = 68;
          const text = el('div', 'txt');
          text.append(el('p', 'name', [p.client, p.title].filter(Boolean).join(' — ') || 'Untitled'));
          if (p.hidden) text.append(el('p', 'hidden-note', 'Hidden — not shown on the website'));
          text.append(el('p', 'sub', [p.country, mediaText(p),
            added.has(id) ? 'new — not published yet' : visChanged(id) ? `${p.hidden ? 'hidden' : 'shown again'} — not published yet` : isMoved(id) ? 'moved here — not published yet' : boardsChanged.has(id) ? 'boards changed — not published yet' : videosChanged.has(id) ? 'videos changed — not published yet' : ''].filter(Boolean).join(' · ')));
          const acts = el('div', 'facts');
          const name = nameOf(id);
          acts.append(
            button('Edit Project', 'link', `Edit the details and boards of ${name}`, () => openDetails(id)),
            button('Manage Boards', 'link', `Add, replace, remove or reorder the boards of ${name}`, () => openDetails(id, 'boards')),
            ...(p.videos?.length || current().id === 'motion'
              ? [button('Manage Videos', 'link', `Add, replace, remove or reorder the videos and thumbnails of ${name}`, () => openDetails(id, 'videos'))] : []),
            button('Change Section', 'link', `Move ${name} to another section`, () => openDetails(id, 'section')),
            button(p.hidden ? 'Unhide' : 'Hide', 'link', p.hidden ? `Show ${name} on the website again` : `Hide ${name} from the website`, () => setHidden(id, !p.hidden)),
            button('Delete Project', 'link link--danger', `Delete ${name} permanently`, () => openDelete(id)),
          );
          text.append(acts);
          const ctrls = el('div', 'ctrls');
          for (const [label, d] of [['↑', -1], ['↓', 1]] as const) {
            const b = el('button', 'mini', label) as HTMLButtonElement;
            b.type = 'button';
            b.setAttribute('aria-label', `Move ${p.client ?? p.title} ${d < 0 ? 'up' : 'down'}`);
            b.disabled = busy || (d < 0 ? i === 0 : i === ids.length - 1);
            b.addEventListener('click', () => { move(ids, i, d); render(); (list.children[i + d]?.querySelectorAll('button')[d < 0 ? 0 : 1] as HTMLElement | undefined)?.focus(); });
            ctrls.append(b);
          }
          li.append(el('span', 'num', String(i + 1).padStart(2, '0')), img, text, ctrls);
          return li;
        }));
        if (!ids.length) list.append(el('li', 'msg', 'No projects in this category yet — use “+ Add project” above.'));
        renderFeatured();
        $<HTMLButtonElement>('[data-publish]').disabled = !dirty || busy;
        if (dirty && !busy) status('Unpublished changes.');
      }

      // ---- Selected Work ----------------------------------------------------------------------
      const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
      for (const t of tabs) {
        t.addEventListener('click', () => {
          for (const o of tabs) o.setAttribute('aria-pressed', String(o === t));
          for (const p of document.querySelectorAll<HTMLElement>('[data-pane]')) p.hidden = p.dataset.pane !== t.dataset.tab;
        });
      }
      const nameOf = (id: string) => { const p = data.projects[id]!; return [p.client, p.title].filter(Boolean).join(' — ') || 'Untitled'; };
      const chapterOf = (id: string) => data.chapters.find((c) => c.projects.includes(id));
      const featuredEdit = () => { featuredChanged = true; dirty = true; render(); };
      const thumbImg = (src: string, w = 96, h = 68) => {
        const img = el('img') as HTMLImageElement;
        img.src = src; img.alt = ''; img.loading = 'lazy'; img.width = w; img.height = h;
        return img;
      };
      const button = (label: string, cls: string, aria: string, fn: () => void, disabled = false) => {
        const b = el('button', cls, label) as HTMLButtonElement;
        b.type = 'button'; b.disabled = busy || disabled; b.setAttribute('aria-label', aria);
        b.addEventListener('click', fn);
        return b;
      };

      function renderFeatured() {
        const root = $<HTMLElement>('[data-featured]');
        const groups = data.featured ?? [];
        root.replaceChildren(...groups.map((g, gi) => {
          const sec = el('section', 'fgroup');
          const head = el('div', 'fgroup-head');
          head.append(el('h2', 'fhead', `${String(gi + 1).padStart(2, '0')} · ${g.title}`), el('p', 'sub', `${g.items.length} of ${MAX_FEATURED}`));
          sec.append(head);
          const ol = el('ol', 'list');
          for (let i = 0; i < MAX_FEATURED; i++) {
            const it = g.items[i];
            const li = el('li', it ? 'item fitem' : 'item fitem is-empty');
            const num = el('span', 'num', String(i + 1).padStart(2, '0'));
            if (!it) {
              const add = i === g.items.length
                ? button('+ Add Project', 'btn btn--ghost', `Add a project to ${g.title}`, () => openPicker(g, null))
                : el('span');
              li.append(num, el('div', 'slot', 'Empty slot'), add);
              ol.append(li);
              continue;
            }
            const name = nameOf(it.project);
            const text = el('div', 'txt');
            const p = data.projects[it.project]!;
            const nv = p.videos?.length ?? 0;
            const sel = [p.boards.length && `${it.boards.length} of ${plural(p.boards.length, 'board')}`, nv && `${it.videos?.length ?? 0} of ${plural(nv, 'video')}`].filter(Boolean).join(' · ');
            text.append(el('p', 'name', name), el('p', 'sub', [chapterOf(it.project)?.title, `${sel} selected`].filter(Boolean).join(' · ')));
            if (p.hidden) text.append(el('p', 'hidden-note', 'Hidden — keeps this slot, not shown on the website until un-hidden'));
            // Small previews of the selected boards, in display order
            const strip = el('div', 'strip');
            it.boards.forEach((b) => {
              const t = thumbImg(thumbFor(it.project, b), 64, 45);
              t.title = `Board ${p.boards.indexOf(b) + 1}`;
              strip.append(t);
            });
            (it.videos ?? []).forEach((vid) => {
              const t = thumbImg(it.covers?.[vid] ? fileUrl(p.folder, it.covers[vid]!) : videoThumb(it.project, vid), 64, 45);
              t.title = `Video ${(p.videos ?? []).findIndex((v) => v.id === vid) + 1}`;
              t.className = 'is-video';
              strip.append(t);
            });
            text.append(strip);
            const ctrls = el('div', 'ctrls');
            ctrls.append(
              button('↑', 'mini', `Move ${name} up`, () => { move(g.items, i, -1); featuredEdit(); }, i === 0),
              button('↓', 'mini', `Move ${name} down`, () => { move(g.items, i, 1); featuredEdit(); }, i === g.items.length - 1),
            );
            const acts = el('div', 'facts');
            acts.append(
              button(nv ? (p.boards.length ? 'Manage Featured Media' : 'Manage Featured Videos') : 'Manage Featured Boards', 'link', `Choose which ${nv ? 'boards and videos' : 'boards'} of ${name} appear in Selected Work`, () => openBoards(it, null)),
              button('Change Project', 'link', `Replace ${name} in ${g.title}`, () => openPicker(g, i)),
              button('Remove', 'link link--danger', `Remove ${name} from ${g.title}`, () => {
                if (!confirm(`Remove “${name}” from Selected Work?\n\nThe project stays in the full portfolio — only the featured reference is removed.`)) return;
                g.items.splice(i, 1); featuredEdit();
              }),
            );
            text.append(acts);
            li.append(num, text, ctrls);
            ol.append(li);
          }
          sec.append(ol);
          return sec;
        }));
        if (!groups.length) root.append(el('p', 'msg', 'No Selected Work groups found in portfolio.json.'));
      }

      // Project picker: existing projects (including ones added in this session), filtered to the
      // group's categories unless "all categories" is ticked; projects already in the group are excluded.
      const picker = $<HTMLDialogElement>('[data-picker]');
      const search = $<HTMLInputElement>('[data-picker-search]');
      const showAll = $<HTMLInputElement>('[data-picker-all]');
      let pickFor: { g: Group; slot: number | null } | null = null;
      function openPicker(g: Group, slot: number | null) {
        if (slot === null && g.items.length >= MAX_FEATURED) return;
        pickFor = { g, slot };
        $<HTMLElement>('[data-picker-title]').textContent = slot === null ? `Add to ${g.title}` : `Replace “${nameOf(g.items[slot]!.project)}”`;
        search.value = ''; showAll.checked = false;
        renderPicker();
        picker.showModal();
        search.focus();
      }
      function renderPicker() {
        if (!pickFor) return;
        const { g, slot } = pickFor;
        const q = search.value.trim().toLowerCase();
        const taken = new Set(g.items.map((it) => it.project));
        const rows: HTMLElement[] = [];
        for (const c of data.chapters) {
          if (!showAll.checked && !g.chapters.includes(c.id)) continue;
          for (const id of c.projects) {
            if (taken.has(id)) continue;
            const name = nameOf(id);
            if (q && !`${name} ${c.title}`.toLowerCase().includes(q)) continue;
            const li = el('li');
            const b = el('button', 'pick') as HTMLButtonElement;
            b.type = 'button';
            const t = el('span', 'txt');
            t.append(el('span', 'name', name), el('span', 'sub', `${c.title} · ${mediaText(data.projects[id]!)}${data.projects[id]!.hidden ? ' · Hidden' : ''}`));
            b.append(thumbImg(thumbFor(id), 72, 51), t);
            // Adding or replacing starts a fresh selection: a project with a single board or video selects
            // it; otherwise the media manager opens, and cancelling it undoes the add/replace.
            b.addEventListener('click', () => {
              const all = data.projects[id]!.boards, vids = data.projects[id]!.videos ?? [];
              const one = all.length + vids.length === 1;
              const item: Item = { project: id, boards: one && all.length ? [all[0]!] : [] };
              if (one && vids.length) item.videos = [vids[0]!.id];
              let undo: () => void;
              if (slot === null) {
                if (g.items.length >= MAX_FEATURED) return;
                g.items.push(item);
                undo = () => { g.items.splice(g.items.indexOf(item), 1); };
              } else {
                const prev = g.items[slot]!;
                g.items[slot] = item;
                undo = () => { g.items[g.items.indexOf(item)] = prev; };
              }
              picker.close();
              if (one) featuredEdit();
              else openBoards(item, undo);
            });
            li.append(b);
            rows.push(li);
          }
        }
        $<HTMLOListElement>('[data-picker-list]').replaceChildren(...(rows.length ? rows : [el('li', 'msg', q || showAll.checked ? 'No matching projects.' : 'No projects in this category yet — add them under All Projects first.')]));
      }
      search.addEventListener('input', renderPicker);
      showAll.addEventListener('change', renderPicker);
      $('[data-picker-close]').addEventListener('click', () => picker.close());

      // Featured boards manager: tick any of the project's boards (uncropped thumbnails), reorder the
      // selection with ↑/↓. Edits a draft; Done applies it (at least one board), Cancel/Esc discards it
      // and, for a just-added/replaced project, undoes that too.
      const bm = $<HTMLDialogElement>('[data-bm]');
      const bmMsg = $<HTMLElement>('[data-bm-msg]');
      // covers: Selected-Work-only thumbnails per video id (a file name, or a new image chosen here)
      let bmFor: { it: Item; draft: string[]; vdraft: string[]; covers: Record<string, string | Board>; undo: (() => void) | null } | null = null;
      function openBoards(it: Item, undo: (() => void) | null) {
        bmFor = { it, draft: [...it.boards], vdraft: [...(it.videos ?? [])], covers: { ...(it.covers ?? {}) }, undo };
        const p = data.projects[it.project]!;
        $<HTMLElement>('[data-bm-boards]').hidden = !p.boards.length;
        $<HTMLElement>('[data-bmv]').hidden = !p.videos?.length;
        $<HTMLElement>('[data-bm-title]').textContent = `Featured ${p.videos?.length ? (p.boards.length ? 'media' : 'videos') : 'boards'} — ${nameOf(it.project)}`;
        bmMsg.textContent = '';
        renderBoards();
        bm.showModal();
      }
      function renderBoards() {
        if (!bmFor) return;
        const { it, draft } = bmFor;
        const all = data.projects[it.project]!.boards;
        const label = (b: string) => `Board ${all.indexOf(b) + 1}`;
        $<HTMLOListElement>('[data-bm-all]').replaceChildren(...all.map((b) => {
          const on = draft.includes(b);
          const li = el('li');
          const lab = el('label', on ? 'cov is-current' : 'cov');
          const box = el('input') as HTMLInputElement;
          box.type = 'checkbox'; box.checked = on;
          box.addEventListener('change', () => {
            if (box.checked) draft.push(b); else draft.splice(draft.indexOf(b), 1);
            bmMsg.textContent = '';
            renderBoards();
            ($<HTMLOListElement>('[data-bm-all]').children[all.indexOf(b)]?.querySelector('input') as HTMLElement | null)?.focus();
          });
          const img = el('img') as HTMLImageElement;
          img.src = thumbFor(it.project, b); img.alt = '';
          const cap = el('span', 'cov-cap');
          cap.append(box, el('span', undefined, label(b)), el('span', 'cov-state', on ? `Selected · #${draft.indexOf(b) + 1}` : 'Not selected'));
          lab.append(img, cap);
          li.append(lab);
          return li;
        }));
        $<HTMLElement>('[data-bm-count]').textContent = `Selected boards (${draft.length}) — display order`;
        const sel = $<HTMLOListElement>('[data-bm-sel]');
        sel.replaceChildren(...(draft.length ? draft.map((b, i) => {
          const li = el('li', 'item bm-item');
          const ctrls = el('div', 'ctrls');
          const mk = (t: string, aria: string, fn: () => void, disabled: boolean) => {
            const x = el('button', 'mini', t) as HTMLButtonElement;
            x.type = 'button'; x.disabled = disabled; x.setAttribute('aria-label', aria);
            x.addEventListener('click', () => { fn(); renderBoards(); });
            ctrls.append(x);
          };
          // swap locally: the draft only counts as a change once Done applies it
          const swap = (j: number) => { [draft[i], draft[j]] = [draft[j]!, draft[i]!]; };
          mk('↑', `Move ${label(b)} earlier`, () => swap(i - 1), i === 0);
          mk('↓', `Move ${label(b)} later`, () => swap(i + 1), i === draft.length - 1);
          mk('✕', `Unselect ${label(b)}`, () => { draft.splice(i, 1); }, false);
          li.append(el('span', 'num', String(i + 1).padStart(2, '0')), thumbImg(thumbFor(it.project, b)), el('p', 'name', label(b)), ctrls);
          return li;
        }) : [el('li', 'msg', 'No boards selected yet.')]));
        renderFeaturedVideos();
      }
      const coverUrl = (c: string | Board, folder: string) => (typeof c === 'string' ? fileUrl(folder, c) : c.url);
      function renderFeaturedVideos() {
        if (!bmFor) return;
        const { it, vdraft, covers } = bmFor;
        const p = data.projects[it.project]!;
        const all = p.videos ?? [];
        const label = (vid: string) => { const k = all.findIndex((v) => v.id === vid); return `Video ${k + 1}${all[k]?.title ? ` — ${all[k]!.title}` : ''}`; };
        $<HTMLOListElement>('[data-bmv-all]').replaceChildren(...all.map((v, k) => {
          const on = vdraft.includes(v.id);
          const li = el('li');
          const lab = el('label', on ? 'cov is-current' : 'cov');
          const box = el('input') as HTMLInputElement;
          box.type = 'checkbox'; box.checked = on;
          box.addEventListener('change', () => {
            if (box.checked) vdraft.push(v.id); else vdraft.splice(vdraft.indexOf(v.id), 1);
            bmMsg.textContent = '';
            renderFeaturedVideos();
            ($<HTMLOListElement>('[data-bmv-all]').children[k]?.querySelector('input') as HTMLElement | null)?.focus();
          });
          const img = el('img') as HTMLImageElement;
          img.src = videoThumb(it.project, v.id); img.alt = '';
          const cap = el('span', 'cov-cap');
          cap.append(box, el('span', undefined, label(v.id)), el('span', 'cov-state', on ? `Selected · #${vdraft.indexOf(v.id) + 1}` : 'Not selected'));
          lab.append(img, cap);
          li.append(lab);
          return li;
        }));
        $<HTMLElement>('[data-bmv-count]').textContent = `Selected videos (${vdraft.length}) — display order`;
        $<HTMLOListElement>('[data-bmv-sel]').replaceChildren(...(vdraft.length ? vdraft.map((vid, i) => {
          const li = el('li', 'item bm-item');
          const ctrls = el('div', 'ctrls');
          const mk = (t: string, aria: string, fn: () => void, disabled: boolean) => {
            const x = el('button', 'mini', t) as HTMLButtonElement;
            x.type = 'button'; x.disabled = disabled; x.setAttribute('aria-label', aria);
            x.addEventListener('click', () => { fn(); renderFeaturedVideos(); });
            ctrls.append(x);
          };
          const swap = (j: number) => { [vdraft[i], vdraft[j]] = [vdraft[j]!, vdraft[i]!]; };
          mk('↑', `Move ${label(vid)} earlier`, () => swap(i - 1), i === 0);
          mk('↓', `Move ${label(vid)} later`, () => swap(i + 1), i === vdraft.length - 1);
          mk('✕', `Unselect ${label(vid)}`, () => { vdraft.splice(i, 1); }, false);
          const c = covers[vid];
          const txt = el('div', 'txt');
          txt.append(el('p', 'name', label(vid)), el('p', 'sub', c ? 'Custom Selected Work thumbnail' : 'Uses the video’s own thumbnail'));
          const acts = el('div', 'facts');
          const lk = (t: string, cls: string, fn: () => void) => { const x = el('button', cls, t) as HTMLButtonElement; x.type = 'button'; x.addEventListener('click', fn); acts.append(x); };
          lk(c ? 'Replace Selected Work thumbnail' : 'Set Selected Work thumbnail', 'link', () => { coverFor = vid; coverInput.click(); });
          if (c) lk('Use video thumbnail', 'link link--danger', () => {
            if (typeof c !== 'string') URL.revokeObjectURL(c.url);
            delete covers[vid];
            renderFeaturedVideos();
          });
          txt.append(acts);
          li.append(el('span', 'num', String(i + 1).padStart(2, '0')), thumbImg(c ? coverUrl(c, p.folder) : videoThumb(it.project, vid)), txt, ctrls);
          return li;
        }) : [el('li', 'msg', 'No videos selected.')]));
      }
      const coverInput = $<HTMLInputElement>('[data-bmv-cover]');
      let coverFor = '';
      coverInput.addEventListener('change', async () => {
        const file = coverInput.files?.[0];
        coverInput.value = '';
        if (!file || !bmFor) return;
        bmMsg.textContent = 'Optimizing image…';
        try {
          const b = await processImage(file, THUMB_EDGE, 320);
          const old = bmFor.covers[coverFor];
          if (old && typeof old !== 'string') URL.revokeObjectURL(old.url);
          bmFor.covers[coverFor] = b;
          bmMsg.textContent = '';
        } catch (e) { bmMsg.textContent = (e as Error).message; }
        renderFeaturedVideos();
      });
      $('[data-bm-done]').addEventListener('click', () => {
        if (!bmFor) return;
        if (!bmFor.draft.length && !bmFor.vdraft.length) { bmMsg.textContent = 'Select at least one board or video.'; return; }
        const { it, draft, vdraft, covers, undo } = bmFor;
        const p = data.projects[it.project]!;
        // Selected Work thumbnails: only for selected videos; new images get new file names
        const prev = it.covers ?? {}, next: Record<string, string> = {};
        for (const vid of vdraft) {
          const c = covers[vid];
          if (!c) continue;
          if (typeof c === 'string') next[vid] = c;
          else { const n = freshName(p.folder, 'v', c.ext); uploads.set(`${p.folder}/${n}`, c); next[vid] = n; }
        }
        for (const [vid, file] of Object.entries(prev)) if (next[vid] !== file) dropFile(p.folder, file);
        for (const [vid, c] of Object.entries(covers)) if (typeof c !== 'string' && !vdraft.includes(vid)) URL.revokeObjectURL(c.url);
        const changed = undo !== null || draft.join() !== it.boards.join() || vdraft.join() !== (it.videos ?? []).join() || JSON.stringify(next) !== JSON.stringify(prev);
        it.boards = draft;
        if (vdraft.length) it.videos = vdraft; else delete it.videos;
        if (Object.keys(next).length) it.covers = next; else delete it.covers;
        bmFor = null;
        bm.close();
        if (changed) featuredEdit();
      });
      const bmCancel = () => {
        if (!bmFor) return;
        for (const c of Object.values(bmFor.covers)) if (typeof c !== 'string') URL.revokeObjectURL(c.url);
        bmFor.undo?.();
        bmFor = null;
        render();
      };
      for (const x of document.querySelectorAll('[data-bm-cancel]')) x.addEventListener('click', () => { bmCancel(); bm.close(); });
      bm.addEventListener('close', bmCancel); // Esc

      // Edit project: the project's text fields and its boards, edited as a draft. "Save changes" applies
      // the whole draft in place (same id, category and position), so the website (both languages) and
      // any Selected Work reference to this id pick it up on the next publish; Cancel/Esc discards it.
      const ed = $<HTMLDialogElement>('[data-ed]');
      const edForm = $<HTMLFormElement>('[data-ed-form]');
      const edMsg = $<HTMLElement>('[data-ed-msg]');
      const FIELDS = ['client', 'title', 'country', 'services'] as const;
      // A draft board: `file` is its name after saving, `orig` the existing board it is or replaces
      // (null = new board), `img` a new image chosen in this dialog.
      type Entry = { file: string; orig: string | null; img: Board | null };
      let edFor = '';
      let entries: Entry[] = [];
      let edStart = '';
      const edChapter = $<HTMLSelectElement>('[data-ed-chapter]');
      let edVideos: VDraft[] = [];
      const edState = () => JSON.stringify([edChapter.value, FIELDS.map((f) => (edForm.elements.namedItem(f) as HTMLInputElement).value), entries.map((e) => e.file), edVideos.map((v) => [v.id, v.url, v.title, v.ratio, v.thumb, v.img?.hash])]);
      const edThumb = (e: Entry) => e.img?.url ?? thumbFor(edFor, e.file);
      let seq = 0;
      // A new, unused image file name in a project folder (prefix d = board, v = video thumbnail)
      function freshName(folder: string, prefix: 'd' | 'v', ext: string) {
        const taken = (n: string) => [inRepo, toDelete, uploads].some((x) => x.has(`${folder}/${n}`));
        let n: string;
        do n = `${prefix}-${Date.now().toString(36)}${(seq++).toString(36)}.${ext}`; while (taken(n));
        return n;
      }
      // An image no longer used: a pending upload is dropped, a published file is deleted after the next deploy
      function dropFile(folder: string, file: string) {
        const key = `${folder}/${file}`;
        const u = uploads.get(key);
        if (u) { URL.revokeObjectURL(u.url); uploads.delete(key); }
        if (inRepo.has(key)) toDelete.add(key);
      }
      function newName(ext: string) {
        const p = data.projects[edFor]!;
        const taken = (n: string) => p.boards.includes(n) || entries.some((e) => e.file === n) || inRepo.has(`${p.folder}/${n}`) || toDelete.has(`${p.folder}/${n}`);
        let n: string;
        do n = `d-${Date.now().toString(36)}${(seq++).toString(36)}.${ext}`; while (taken(n));
        return n;
      }
      // Same image chosen twice (in this draft, or already waiting to be uploaded for this project)
      const isDuplicate = (b: Board) => entries.some((e) => (e.img ?? uploads.get(`${data.projects[edFor]!.folder}/${e.file}`))?.hash === b.hash);

      function openDetails(id: string, focus?: 'boards' | 'section' | 'videos') {
        edFor = id;
        const p = data.projects[id]!;
        for (const f of FIELDS) (edForm.elements.namedItem(f) as HTMLInputElement).value = p[f] ?? '';
        edChapter.value = chapterOf(id)!.id;
        entries = p.boards.map((f) => ({ file: f, orig: f, img: null }));
        edVideos = toDrafts(p);
        $<HTMLElement>('[data-ed-title]').textContent = `Edit project — ${nameOf(id)}`;
        edMsg.textContent = '';
        renderEntries();
        renderEdVideos();
        edStart = edState();
        ed.showModal();
        if (focus === 'section') edChapter.focus();
        if (focus === 'boards') { $<HTMLElement>('[data-eb-count]').scrollIntoView({ block: 'start' }); document.querySelector<HTMLElement>('[data-eb] button')?.focus({ preventScroll: true }); }
        if (focus === 'videos') { $<HTMLElement>('[data-ev-count]').scrollIntoView({ block: 'start' }); document.querySelector<HTMLElement>('[data-ev] input, [data-ev] button')?.focus({ preventScroll: true }); }
      }

      let dragFrom = -1;
      function renderEntries() {
        const ol = $<HTMLOListElement>('[data-eb]');
        $<HTMLElement>('[data-eb-count]').textContent = `Manage boards (${entries.length})`;
        ol.replaceChildren(...entries.map((e, i) => {
          const li = el('li', 'board eb-item');
          li.draggable = true;
          li.addEventListener('dragstart', (ev) => { dragFrom = i; li.classList.add('is-dragging'); ev.dataTransfer!.effectAllowed = 'move'; ev.dataTransfer!.setData('text/plain', String(i)); });
          li.addEventListener('dragend', () => { dragFrom = -1; li.classList.remove('is-dragging'); });
          li.addEventListener('dragover', (ev) => { if (dragFrom < 0) return; ev.preventDefault(); li.classList.add('is-over'); });
          li.addEventListener('dragleave', () => li.classList.remove('is-over'));
          li.addEventListener('drop', (ev) => {
            ev.preventDefault();
            if (dragFrom < 0 || dragFrom === i) return;
            const [x] = entries.splice(dragFrom, 1);
            entries.splice(i, 0, x!);
            dragFrom = -1;
            renderEntries();
          });
          const img = el('img') as HTMLImageElement;
          img.src = edThumb(e); img.alt = `Board ${i + 1}`; img.draggable = false;
          const tag = e.orig === null ? 'New' : e.img ? 'Replaced' : '';
          const ctrls = el('div', 'ctrls');
          const mk = (label: string, cls: string, aria: string, fn: () => void, disabled = false) => {
            const b = el('button', cls, label) as HTMLButtonElement;
            b.type = 'button'; b.disabled = disabled; b.setAttribute('aria-label', aria);
            b.addEventListener('click', fn);
            ctrls.append(b);
          };
          const focusAt = (j: number, k: number) => (ol.children[j]?.querySelectorAll('button')[k] as HTMLElement | undefined)?.focus();
          // swap locally: the draft only counts as a change once "Save changes" applies it
          const swap = (j: number) => { [entries[i], entries[j]] = [entries[j]!, entries[i]!]; renderEntries(); focusAt(j, j < i ? 0 : 1); };
          mk('↑', 'mini', `Move board ${i + 1} up`, () => swap(i - 1), i === 0);
          mk('↓', 'mini', `Move board ${i + 1} down`, () => swap(i + 1), i === entries.length - 1);
          const acts = el('div', 'facts');
          const link = (label: string, cls: string, aria: string, fn: () => void) => {
            const b = el('button', cls, label) as HTMLButtonElement;
            b.type = 'button'; b.setAttribute('aria-label', aria);
            b.addEventListener('click', fn);
            acts.append(b);
          };
          link('Replace', 'link', `Replace board ${i + 1}`, () => { replaceAt = i; replaceInput.click(); });
          if (e.img && e.orig) link('Undo', 'link', `Undo the replacement of board ${i + 1}`, () => {
            URL.revokeObjectURL(e.img!.url);
            entries[i] = { file: e.orig!, orig: e.orig, img: null };
            renderEntries();
          });
          link('Remove', 'link link--danger', `Remove board ${i + 1}`, () => removeEntry(i));
          li.append(el('span', 'num', String(i + 1)), img);
          if (tag) li.append(el('span', 'eb-tag', tag));
          li.append(el('div', 'eb-row'));
          li.lastElementChild!.append(ctrls, acts);
          return li;
        }));
      }

      function removeEntry(i: number) {
        const e = entries[i]!;
        if (entries.length === 1 && !edVideos.length) { edMsg.textContent = 'A project needs at least one board or video — use Replace instead.'; return; }
        const inFeatured = e.orig !== null && (data.featured ?? []).some((g) => g.items.some((it) => it.project === edFor && it.boards.includes(e.orig!)));
        if (!confirm(`Remove board ${i + 1}?${inFeatured ? '\n\nThis board is shown in Selected Work and will be removed there too.' : ''}\n\nNothing is published until you click Save & Publish.`)) return;
        if (e.img) URL.revokeObjectURL(e.img.url);
        entries.splice(i, 1);
        edMsg.textContent = '';
        renderEntries();
      }

      const replaceInput = $<HTMLInputElement>('[data-eb-replace]');
      let replaceAt = -1;
      replaceInput.addEventListener('change', async () => {
        const file = replaceInput.files?.[0];
        replaceInput.value = '';
        const i = replaceAt;
        if (!file || !entries[i]) return;
        edMsg.textContent = 'Optimizing image…';
        try {
          const b = await processImage(file);
          if (isDuplicate(b)) { URL.revokeObjectURL(b.url); throw new Error(`${file.name}: this image is already one of the project’s new boards.`); }
          const old = entries[i]!;
          if (old.img) URL.revokeObjectURL(old.img.url);
          entries[i] = { file: newName(b.ext), orig: old.orig, img: b }; // same position, same Selected Work link
          edMsg.textContent = '';
        } catch (e) { edMsg.textContent = (e as Error).message; }
        renderEntries();
      });

      const addInput = $<HTMLInputElement>('[data-eb-add]');
      addInput.addEventListener('change', async () => {
        const chosen = [...(addInput.files ?? [])];
        addInput.value = '';
        if (entries.length + chosen.length > MAX_BOARDS) { edMsg.textContent = `A project can have at most ${MAX_BOARDS} boards.`; return; }
        edMsg.textContent = 'Optimizing images…';
        const errors: string[] = [];
        for (const f of chosen) {
          try {
            const b = await processImage(f);
            if (isDuplicate(b)) { URL.revokeObjectURL(b.url); throw new Error(`${f.name}: already added.`); }
            entries.push({ file: newName(b.ext), orig: null, img: b });
          } catch (e) { errors.push((e as Error).message); }
        }
        edMsg.textContent = errors.join(' ');
        renderEntries();
      });

      edForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const p = data.projects[edFor];
        if (!p) return;
        const v = Object.fromEntries(FIELDS.map((f) => [f, (edForm.elements.namedItem(f) as HTMLInputElement).value.trim() || null]));
        if (!v.client && !v.title) { edMsg.textContent = 'Enter a project name or a project title.'; return; }
        if (!entries.length && !edVideos.length) { edMsg.textContent = 'A project needs at least one board or video.'; return; }
        try { videoUrls(edVideos); } catch (err) { edMsg.textContent = (err as Error).message; return; }
        if (FIELDS.some((f) => p[f] !== v[f])) {
          for (const f of FIELDS) p[f] = v[f] ?? null;
          detailsChanged = true; dirty = true;
        }
        const next = entries.map((x) => x.file);
        if (next.join() !== p.boards.join()) {
          // Boards no longer used: drop not-yet-uploaded files; published ones are deleted after the next deploy
          for (const f of p.boards.filter((b) => !next.includes(b))) {
            const key = `${p.folder}/${f}`;
            const u = uploads.get(key);
            if (u) { URL.revokeObjectURL(u.url); uploads.delete(key); }
            if (inRepo.has(key)) toDelete.add(key);
          }
          for (const x of entries) if (x.img) uploads.set(`${p.folder}/${x.file}`, x.img);
          p.boards = next;
          if (!added.has(edFor)) boardsChanged.add(edFor);
          dirty = true;
        }
        if (applyVideos(edFor, edVideos)) {
          if (!added.has(edFor)) videosChanged.add(edFor);
          dirty = true;
        }
        // Selected Work: a replaced board keeps its place there; removed boards/videos are dropped
        syncFeatured(edFor, new Map(entries.filter((x) => x.img && x.orig).map((x) => [x.orig!, x.file])));
        // Section: the same project (id, details, boards) leaves its section and goes to the end of the
        // chosen one. A Selected Work entry keeps its boards; it follows to the group for the new section
        // when that group has a free slot, otherwise it stays where it is (other entries are untouched).
        const from = chapterOf(edFor)!, to = data.chapters.find((c) => c.id === edChapter.value)!;
        let note = '';
        if (to.id !== from.id) {
          from.projects.splice(from.projects.indexOf(edFor), 1);
          to.projects.push(edFor);
          if (!moved.has(edFor)) moved.set(edFor, from.id);
          dirty = true;
          for (const g of data.featured ?? []) {
            const it = g.items.find((x) => x.project === edFor);
            if (!it || g.chapters.includes(to.id)) continue;
            const target = (data.featured ?? []).find((x) => x.chapters.includes(to.id));
            if (target && target.items.length < MAX_FEATURED && !target.items.some((x) => x.project === edFor)) {
              g.items.splice(g.items.indexOf(it), 1);
              target.items.push(it);
              featuredChanged = true;
            } else {
              note = ` “${nameOf(edFor)}” is still featured in Selected Work › ${g.title}${target ? ` (${target.title} has no free slot)` : ''} — change it in the Selected Work tab if needed.`;
            }
          }
          catSelect.value = to.id;
        }
        entries = [];
        edVideos = [];
        ed.close();
        render();
        if (note) status(`Unpublished changes.${note}`);
      });
      // Discard the draft (Cancel, ✕ or Esc); ask first when it has changes
      const edDiscard = () => {
        if (entries.length && edState() !== edStart && !confirm('Discard your changes to this project?')) return false;
        for (const x of entries) if (x.img) URL.revokeObjectURL(x.img.url);
        for (const x of edVideos) if (x.img) URL.revokeObjectURL(x.img.url);
        entries = [];
        edVideos = [];
        return true;
      };
      for (const x of document.querySelectorAll('[data-ed-cancel]')) x.addEventListener('click', () => { if (edDiscard()) ed.close(); });
      ed.addEventListener('cancel', (e) => { if (!edDiscard()) e.preventDefault(); });

      // ---- Videos (Google Drive) ---------------------------------------------------------------
      // One editor for "New project" and "Edit project". A draft keeps the video's permanent `id`;
      // `thumb` is its current thumbnail file (null = placeholder), `img` a thumbnail chosen in this draft.
      // Nothing changes until the form is saved.
      type VDraft = { id: string; url: string; title: string; ratio: Ratio; auto: boolean; thumb: string | null; img: Board | null; player: boolean };
      const toDrafts = (p: Stored) => (p.videos ?? []).map((v): VDraft => ({ id: v.id, url: v.url, title: v.title ?? '', ratio: v.ratio, auto: false, thumb: v.thumb, img: null, player: false }));
      let vseq = 0;
      function newVideoId(list: VDraft[]) {
        const used = new Set([...Object.values(data.projects).flatMap((p) => (p.videos ?? []).map((v) => v.id)), ...list.map((v) => v.id)]);
        let id: string;
        do id = `v${Date.now().toString(36)}${(vseq++).toString(36)}`; while (used.has(id));
        return id;
      }
      const nearestRatio = (w: number, h: number) => RATIOS.reduce((a, r) => (Math.abs(Math.log(w / h / ratioValue(r))) < Math.abs(Math.log(w / h / ratioValue(a))) ? r : a));
      // Valid Drive links (normalized to …/file/d/ID/view), or an error naming the video
      function videoUrls(list: VDraft[]) {
        return list.map((v, i) => {
          const id = driveId(v.url);
          if (!id) throw new Error(`Video ${i + 1}: ${v.url.trim() ? 'this is not a Google Drive file link (https://drive.google.com/file/d/…/view).' : 'paste its Google Drive link.'}`);
          return driveView(id);
        });
      }
      // Writes the draft into the project (call videoUrls first). Returns whether anything changed.
      function applyVideos(id: string, list: VDraft[]) {
        const p = data.projects[id]!;
        const urls = videoUrls(list);
        const next: SVideo[] = list.map((v, i) => {
          let thumb = v.thumb;
          if (v.img) { thumb = freshName(p.folder, 'v', v.img.ext); uploads.set(`${p.folder}/${thumb}`, v.img); }
          return { id: v.id, url: urls[i]!, title: v.title.trim() || null, ratio: v.ratio, thumb };
        });
        if (JSON.stringify(next) === JSON.stringify(p.videos ?? [])) return false;
        const keep = new Set(next.map((v) => v.thumb));
        for (const v of p.videos ?? []) if (v.thumb && !keep.has(v.thumb)) dropFile(p.folder, v.thumb);
        if (next.length) p.videos = next; else delete p.videos;
        return true;
      }
      // Selected Work entries of a project after its boards/videos changed: replaced boards keep their
      // place (swap: old → new file), removed boards and videos are dropped (with their Selected Work
      // thumbnails); an entry left empty shows the project's first board, else its first video.
      function syncFeatured(id: string, swap = new Map<string, string>()) {
        const p = data.projects[id]!;
        const vids = (p.videos ?? []).map((v) => v.id);
        for (const g of data.featured ?? []) for (const it of g.items) {
          if (it.project !== id) continue;
          const before = JSON.stringify(it);
          it.boards = [...new Set(it.boards.map((b) => swap.get(b) ?? b).filter((b) => p.boards.includes(b)))];
          const v = (it.videos ?? []).filter((x) => vids.includes(x));
          for (const [vid, file] of Object.entries(it.covers ?? {})) if (!v.includes(vid)) { dropFile(p.folder, file); delete it.covers![vid]; }
          if (!it.boards.length && !v.length) { if (p.boards.length) it.boards = [p.boards[0]!]; else if (vids.length) v.push(vids[0]!); }
          if (v.length) it.videos = v; else delete it.videos;
          if (it.covers && !Object.keys(it.covers).length) delete it.covers;
          if (JSON.stringify(it) !== before) featuredChanged = true;
        }
      }

      // Sharing check: Drive serves a preview image of a file only when it is shared publicly. A failure is
      // only a warning (a just-uploaded video may still be processing).
      const shared = new Map<string, Promise<boolean>>();
      const isShared = (id: string) => {
        if (!shared.has(id)) shared.set(id, new Promise((ok) => {
          const probe = new Image();
          probe.referrerPolicy = 'no-referrer';
          probe.onload = () => ok(probe.naturalWidth > 0);
          probe.onerror = () => ok(false);
          probe.src = `https://drive.google.com/thumbnail?id=${encodeURIComponent(id)}&sz=w200`;
        }));
        return shared.get(id)!;
      };

      function videoEditor(root: HTMLElement, list: () => VDraft[], folder: () => string | null, say: (t: string) => void) {
        const fileIn = el('input') as HTMLInputElement;
        fileIn.type = 'file'; fileIn.accept = TYPES.join(','); fileIn.hidden = true;
        let target: VDraft | null = null;
        fileIn.addEventListener('change', async () => {
          const file = fileIn.files?.[0];
          fileIn.value = '';
          const v = target;
          if (!file || !v) return;
          say('Optimizing thumbnail…');
          try {
            const b = await processImage(file, THUMB_EDGE, 320);
            if (v.img) URL.revokeObjectURL(v.img.url);
            v.img = b;
            // Until the ratio is chosen by hand, it follows the thumbnail's proportions
            if (v.auto) v.ratio = nearestRatio(b.w, b.h);
            say(v.auto ? `Thumbnail added. Aspect ratio set to ${v.ratio} from its proportions — change it if the video differs.` : '');
          } catch (e) { say((e as Error).message); }
          draw();
        });
        const check = (v: VDraft, out: HTMLElement) => {
          const id = driveId(v.url);
          out.className = 'vstatus';
          if (!v.url.trim()) { out.textContent = 'Paste the video’s Google Drive sharing link.'; return; }
          if (!id) { out.textContent = 'Not a Google Drive file link — use the link from Share › Copy link (…/file/d/FILE_ID/view).'; out.classList.add('err'); return; }
          out.textContent = 'Google Drive link ✓ · checking sharing…';
          isShared(id).then((ok) => {
            if (driveId(v.url) !== id) return;
            out.textContent = ok ? 'Google Drive link ✓ · publicly viewable ✓ — the website embeds /preview of this file'
              : 'Google Drive link ✓ · Drive returned no preview: set sharing to “Anyone with the link · Viewer” (new uploads can take a few minutes to process)';
            out.classList.add(ok ? 'ok' : 'warn');
          });
        };
        function draw() {
          const vs = list();
          const ol = el('ol', 'vlist');
          ol.setAttribute('aria-label', 'Videos');
          vs.forEach((v, i) => {
            const li = el('li', 'vitem');
            const media = el('div', 'vmedia');
            const ratioCss = v.ratio.replace(':', ' / ');
            const src = v.img?.url ?? (v.thumb && folder() ? fileUrl(folder()!, v.thumb) : null);
            if (src) { const im = thumbImg(src, 160, 90); im.alt = `Thumbnail of video ${i + 1}`; media.append(im); }
            else { const ph = el('div', 'vph'); ph.style.aspectRatio = ratioCss; ph.append(el('span', undefined, 'No thumbnail')); media.append(ph); }
            media.append(el('span', 'num', String(i + 1)));
            if (v.img) media.append(el('span', 'eb-tag', v.thumb ? 'New thumbnail' : 'Thumbnail'));

            const fields = el('div', 'vfields');
            const linkLab = el('label', undefined, 'Google Drive link');
            const link = el('input') as HTMLInputElement;
            link.type = 'url'; link.value = v.url; link.placeholder = 'https://drive.google.com/file/d/…/view'; link.spellcheck = false; link.autocomplete = 'off';
            const st = el('p', 'vstatus');
            let t = 0;
            link.addEventListener('input', () => { v.url = link.value; clearTimeout(t); t = window.setTimeout(() => check(v, st), 350); });
            link.addEventListener('change', () => { v.url = link.value.trim(); if (v.player) draw(); });
            linkLab.append(link);
            const row = el('div', 'vrow');
            const tLab = el('label', undefined, 'Video title (optional)');
            const tIn = el('input') as HTMLInputElement;
            tIn.value = v.title; tIn.maxLength = 120;
            tIn.addEventListener('input', () => { v.title = tIn.value; });
            tLab.append(tIn);
            const rLab = el('label', undefined, 'Aspect ratio');
            const rSel = el('select') as HTMLSelectElement;
            const names: Record<string, string> = { '16:9': '16:9 · landscape', '9:16': '9:16 · vertical', '1:1': '1:1 · square', '4:5': '4:5 · portrait' };
            for (const r of RATIOS) { const o = el('option', undefined, names[r]) as HTMLOptionElement; o.value = r; o.selected = r === v.ratio; rSel.append(o); }
            rSel.addEventListener('change', () => { v.ratio = rSel.value as Ratio; v.auto = false; draw(); (root.querySelectorAll('select')[i] as HTMLElement | undefined)?.focus(); });
            rLab.append(rSel);
            row.append(tLab, rLab);
            const acts = el('div', 'facts');
            const lk = (label: string, cls: string, aria: string, fn: () => void) => {
              const b = el('button', cls, label) as HTMLButtonElement;
              b.type = 'button'; b.setAttribute('aria-label', aria); b.addEventListener('click', fn); acts.append(b);
            };
            lk(src ? 'Replace thumbnail' : 'Upload thumbnail', 'link', `${src ? 'Replace' : 'Upload'} the thumbnail of video ${i + 1}`, () => { target = v; fileIn.click(); });
            if (v.img && v.thumb) lk('Undo thumbnail', 'link', `Keep the current thumbnail of video ${i + 1}`, () => { URL.revokeObjectURL(v.img!.url); v.img = null; draw(); });
            if (src) lk('Remove thumbnail', 'link link--danger', `Remove the thumbnail of video ${i + 1}`, () => {
              if (v.img) URL.revokeObjectURL(v.img.url);
              v.img = null; v.thumb = null; draw();
            });
            lk(v.player ? 'Hide player' : 'Preview player', 'link', `${v.player ? 'Hide' : 'Show'} the Google Drive player of video ${i + 1}`, () => { v.player = !v.player; draw(); });
            fields.append(linkLab, st, row, acts);

            const ctrls = el('div', 'ctrls');
            const mk = (label: string, aria: string, fn: () => void, disabled = false) => {
              const b = el('button', 'mini', label) as HTMLButtonElement;
              b.type = 'button'; b.disabled = disabled; b.setAttribute('aria-label', aria);
              b.addEventListener('click', fn); ctrls.append(b);
            };
            const swap = (j: number) => { [vs[i], vs[j]] = [vs[j]!, vs[i]!]; draw(); (root.querySelectorAll('.vitem')[j]?.querySelectorAll('.ctrls button')[j < i ? 0 : 1] as HTMLElement | undefined)?.focus(); };
            mk('↑', `Move video ${i + 1} up`, () => swap(i - 1), i === 0);
            mk('↓', `Move video ${i + 1} down`, () => swap(i + 1), i === vs.length - 1);
            mk('✕', `Remove video ${i + 1}`, () => {
              const featured = (data.featured ?? []).some((g) => g.items.some((it) => it.videos?.includes(v.id)));
              if (!confirm(`Remove video ${i + 1}?${featured ? '\n\nThis video is shown in Selected Work and will be removed there too.' : ''}\n\nThe file on Google Drive is not touched. Nothing is published until you click Save & Publish.`)) return;
              if (v.img) URL.revokeObjectURL(v.img.url);
              vs.splice(i, 1); draw();
            });

            li.append(media, fields, ctrls);
            const id = driveId(v.url);
            if (v.player && id) {
              const pl = el('div', 'vplayer');
              pl.style.aspectRatio = ratioCss;
              if (v.ratio !== '16:9') pl.style.maxWidth = `${Math.round(360 * ratioValue(v.ratio))}px`;
              const f = el('iframe') as HTMLIFrameElement;
              f.src = drivePreview(id); f.title = `Preview of video ${i + 1}`;
              f.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media'; f.allowFullscreen = true;
              pl.append(f);
              li.append(pl);
            }
            check(v, st);
            ol.append(li);
          });
          if (!vs.length) ol.append(el('li', 'msg', 'No videos.'));
          const add = el('button', 'btn btn--ghost', '+ Add video') as HTMLButtonElement;
          add.type = 'button';
          add.addEventListener('click', () => {
            vs.push({ id: newVideoId(vs), url: '', title: '', ratio: '16:9', auto: true, thumb: null, img: null, player: false });
            draw();
            (root.querySelectorAll<HTMLInputElement>('.vitem input[type=url]')[vs.length - 1])?.focus();
          });
          root.replaceChildren(ol, add, fileIn);
        }
        return draw;
      }
      const renderEdVideos = videoEditor($('[data-ev]'), () => edVideos, () => data.projects[edFor]?.folder ?? null, (t) => { edMsg.textContent = t; });

      // ---- Hide / Unhide -----------------------------------------------------------------------
      // Only the flag changes: section, position, details, boards and Selected Work entries stay.
      function setHidden(id: string, hide: boolean) {
        const p = data.projects[id]!;
        if (hide) p.hidden = true; else delete p.hidden;
        dirty = true;
        render();
        status(`Unpublished changes. “${nameOf(id)}” will be ${hide ? 'hidden from' : 'shown again on'} the website (English and French) after Save & Publish.`);
      }

      // ---- Delete project -----------------------------------------------------------------------
      const del = $<HTMLDialogElement>('[data-del]');
      const delInput = $<HTMLInputElement>('[data-del-input]');
      const delOk = $<HTMLButtonElement>('[data-del-ok]');
      let delFor = '';
      function openDelete(id: string) {
        delFor = id;
        const p = data.projects[id]!;
        $<HTMLElement>('[data-del-name]').textContent = nameOf(id);
        const refs = [
          `Section ${chapterOf(id)?.title ?? '—'} · ${mediaText(p)}${p.videos?.length ? ' (the video files on Google Drive are not touched)' : ''}`,
          ...(data.featured ?? []).filter((g) => g.items.some((it) => it.project === id)).map((g) => `Selected Work › ${g.title}`),
        ];
        $<HTMLElement>('[data-del-refs]').replaceChildren(...refs.map((r) => el('li', undefined, r)));
        delInput.value = '';
        delOk.disabled = true;
        del.showModal();
        delInput.focus();
      }
      delInput.addEventListener('input', () => { delOk.disabled = delInput.value.trim().toUpperCase() !== 'DELETE'; });
      for (const x of document.querySelectorAll('[data-del-cancel]')) x.addEventListener('click', () => del.close());
      $<HTMLFormElement>('[data-del-form]').addEventListener('submit', (e) => {
        e.preventDefault();
        if (delInput.value.trim().toUpperCase() !== 'DELETE' || !data.projects[delFor]) return;
        const name = nameOf(delFor);
        deleteProject(delFor);
        del.close();
        render();
        status(`Unpublished changes. “${name}” will be deleted when you click Save & Publish (reload the page to undo before that).`);
      });
      // Removes the project and every reference to it (section list, Selected Work). Its board images
      // are queued for the post-deploy cleanup, which deletes only files no project references any more.
      function deleteProject(id: string) {
        const p = data.projects[id]!;
        const name = p.client ?? p.title ?? id;
        const images = [...p.boards, ...(p.videos ?? []).flatMap((v) => (v.thumb ? [v.thumb] : []))];
        for (const c of data.chapters) c.projects = c.projects.filter((x) => x !== id);
        for (const g of data.featured ?? []) {
          const n = g.items.length;
          for (const it of g.items) if (it.project === id) images.push(...Object.values(it.covers ?? {}));
          g.items = g.items.filter((it) => it.project !== id);
          if (g.items.length !== n) featuredChanged = true;
        }
        delete data.projects[id];
        const used = referenced(data);
        for (const b of images) {
          if (used.has(`${p.folder}/${b}`)) continue; // shared with another project: kept
          dropFile(p.folder, b);
        }
        // A project added in this session and never published simply disappears
        if (added.has(id)) added.delete(id); else deleted.set(id, name);
        boardsChanged.delete(id);
        videosChanged.delete(id);
        moved.delete(id);
        reserved.add(id); // never reused by a new project
        dirty = true;
      }

      // Checked again right before publishing (also protects against a hand-edited file)
      function validateFeatured() {
        for (const c of data.chapters) for (const id of c.projects) {
          const p = data.projects[id];
          if (!p) throw new Error(`section “${c.title}” refers to a project that no longer exists (${id})`);
          if (!p.boards.length && !p.videos?.length) throw new Error(`“${nameOf(id)}” has no boards or videos`);
          const ids = new Set<string>();
          for (const [i, v] of (p.videos ?? []).entries()) {
            if (!driveId(v.url)) throw new Error(`video ${i + 1} of “${nameOf(id)}” has an invalid Google Drive link`);
            if (!v.id || ids.has(v.id)) throw new Error(`“${nameOf(id)}” has a repeated video id`);
            if (!RATIOS.includes(v.ratio)) throw new Error(`video ${i + 1} of “${nameOf(id)}” has no aspect ratio`);
            ids.add(v.id);
          }
        }
        for (const g of data.featured ?? []) {
          if (g.items.length > MAX_FEATURED) throw new Error(`“${g.title}” has more than ${MAX_FEATURED} projects`);
          const seen = new Set<string>();
          for (const it of g.items) {
            const p = data.projects[it.project];
            if (!p || !chapterOf(it.project)) throw new Error(`“${g.title}” refers to a project that no longer exists (${it.project})`);
            if (seen.has(it.project)) throw new Error(`“${nameOf(it.project)}” appears twice in “${g.title}”`);
            seen.add(it.project);
            if (!it.boards.length && !it.videos?.length) throw new Error(`“${nameOf(it.project)}” has no selected boards or videos`);
            if (new Set(it.boards).size !== it.boards.length || it.boards.some((b) => !p.boards.includes(b)))
              throw new Error(`the selected boards of “${nameOf(it.project)}” do not match its boards`);
            const vids = (p.videos ?? []).map((v) => v.id), sel = it.videos ?? [];
            if (new Set(sel).size !== sel.length || sel.some((v) => !vids.includes(v)) || Object.keys(it.covers ?? {}).some((v) => !sel.includes(v)))
              throw new Error(`the selected videos of “${nameOf(it.project)}” do not match its videos`);
          }
        }
      }

      function move<T>(arr: T[], i: number, d: number) {
        const j = i + d;
        if (j < 0 || j >= arr.length) return;
        [arr[i], arr[j]] = [arr[j]!, arr[i]!];
        dirty = true;
      }
      const status = (t: string, kind = '') => {
        const s = $<HTMLElement>('[data-status]');
        s.textContent = t;
        s.className = `msg ${kind}`;
      };
      window.addEventListener('beforeunload', (e) => { if (dirty) e.preventDefault(); });

      // ---- Add project ------------------------------------------------------------------------
      const addForm = $<HTMLFormElement>('[data-add-form]');
      const addMsg = $<HTMLElement>('[data-add-msg]');
      $('[data-add]').addEventListener('click', () => {
        addForm.hidden = false;
        ($<HTMLSelectElement>('[data-add-chapter]')).value = catSelect.value;
        (addForm.elements.namedItem('name') as HTMLInputElement).focus();
      });
      let addVideos: VDraft[] = [];
      const renderAddVideos = videoEditor($('[data-add-videos]'), () => addVideos, () => null, (t) => { addMsg.textContent = t; });
      renderAddVideos();
      const closeAdd = () => {
        draft.forEach((b) => URL.revokeObjectURL(b.url)); draft = [];
        addVideos.forEach((v) => v.img && URL.revokeObjectURL(v.img.url)); addVideos = [];
        addForm.reset(); addForm.hidden = true; addMsg.textContent = ''; renderDraft(); renderAddVideos();
      };
      $('[data-add-cancel]').addEventListener('click', closeAdd);

      // Resize to the web-master size and convert to WebP in the browser (JPEG where WebP encoding
      // is unavailable). Decoding doubles as content validation: non-images fail here.
      async function processImage(file: File, maxEdge = MAX_EDGE, minEdge = 600): Promise<Board> {
        if (!TYPES.includes(file.type)) throw new Error(`${file.name}: only JPG, PNG or WebP images are accepted.`);
        if (file.size > MAX_BYTES) throw new Error(`${file.name}: larger than 25 MB.`);
        let bmp: ImageBitmap;
        try { bmp = await createImageBitmap(file, { imageOrientation: 'from-image' }); }
        catch { throw new Error(`${file.name}: not a readable image.`); }
        if (Math.max(bmp.width, bmp.height) < minEdge) throw new Error(`${file.name}: too small (at least ${minEdge} px on the long side).`);
        const scale = Math.min(1, maxEdge / Math.max(bmp.width, bmp.height));
        const c = document.createElement('canvas');
        c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
        const ctx = c.getContext('2d')!;
        ctx.fillStyle = '#ffffff';             // transparent PNGs sit on white, like the existing boards
        ctx.fillRect(0, 0, c.width, c.height);
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(bmp, 0, 0, c.width, c.height);
        bmp.close();
        const encode = (type: string, q: number) => new Promise<Blob | null>((ok) => c.toBlob(ok, type, q));
        let blob = await encode('image/webp', 0.86);
        let ext: 'webp' | 'jpg' = 'webp';
        if (!blob || blob.type !== 'image/webp') { blob = await encode('image/jpeg', 0.88); ext = 'jpg'; }
        if (!blob) throw new Error(`${file.name}: could not be processed.`);
        const hash = [...new Uint8Array(await crypto.subtle.digest('SHA-256', await file.arrayBuffer()))].map((x) => x.toString(16).padStart(2, '0')).join('');
        return { blob, ext, url: URL.createObjectURL(blob), name: file.name, hash, w: c.width, h: c.height };
      }

      const filesInput = $<HTMLInputElement>('[data-files]');
      filesInput.addEventListener('change', async () => {
        const chosen = [...(filesInput.files ?? [])];
        filesInput.value = '';
        if (draft.length + chosen.length > MAX_BOARDS) { addMsg.textContent = `A project can have at most ${MAX_BOARDS} boards.`; return; }
        addMsg.textContent = 'Optimizing images…';
        const errors: string[] = [];
        for (const f of chosen) {
          try {
            const b = await processImage(f);
            if (draft.some((x) => x.hash === b.hash)) { URL.revokeObjectURL(b.url); throw new Error(`${f.name}: already added.`); }
            draft.push(b);
          } catch (e) { errors.push((e as Error).message); }
        }
        addMsg.textContent = errors.join(' ');
        renderDraft();
      });

      function renderDraft() {
        const ol = $<HTMLOListElement>('[data-boards]');
        ol.replaceChildren(...draft.map((b, i) => {
          const li = el('li', 'board');
          const img = el('img') as HTMLImageElement;
          img.src = b.url; img.alt = `Board ${i + 1}`;
          const ctrls = el('div', 'ctrls');
          const mk = (label: string, aria: string, fn: () => void, disabled = false) => {
            const btn = el('button', 'mini', label) as HTMLButtonElement;
            btn.type = 'button'; btn.disabled = disabled; btn.setAttribute('aria-label', aria);
            btn.addEventListener('click', () => { fn(); renderDraft(); });
            ctrls.append(btn);
          };
          mk('←', `Move board ${i + 1} earlier`, () => { [draft[i - 1], draft[i]] = [draft[i]!, draft[i - 1]!]; }, i === 0);
          mk('→', `Move board ${i + 1} later`, () => { [draft[i + 1], draft[i]] = [draft[i]!, draft[i + 1]!]; }, i === draft.length - 1);
          mk('✕', `Remove board ${i + 1}`, () => { URL.revokeObjectURL(b.url); draft.splice(i, 1); });
          li.append(el('span', 'num', String(i + 1)), img, ctrls);
          return li;
        }));
      }

      // Safe ids/folders: ASCII letters, digits and hyphens only — never user-controlled paths.
      function slug(s: string) {
        return s.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLowerCase()
          .replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 40) || 'project';
      }

      addForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = (addForm.elements.namedItem('name') as HTMLInputElement).value.trim();
        const country = (addForm.elements.namedItem('country') as HTMLInputElement).value.trim();
        const chapter = (addForm.elements.namedItem('chapter') as HTMLSelectElement).value;
        if (!name) { addMsg.textContent = 'Enter a project name.'; return; }
        if (!draft.length && !addVideos.length) { addMsg.textContent = 'Add at least one presentation board or video.'; return; }
        try { videoUrls(addVideos); } catch (err) { addMsg.textContent = (err as Error).message; return; }
        const folders = new Set(Object.values(data.projects).map((p) => p.folder));
        let id = `${chapter}-${slug(name)}`;
        for (let n = 2; data.projects[id] || folders.has(id) || reserved.has(id); n++) id = `${chapter}-${slug(name)}-${n}`;
        const boards = draft.map((b, i) => `d-${String(i + 1).padStart(2, '0')}.${b.ext}`);
        data.projects[id] = { client: name, title: null, country: country || null, services: null, folder: id, boards };
        data.chapters.find((c) => c.id === chapter)!.projects.push(id); // added at the end; move it with ↑/↓
        draft.forEach((b, i) => uploads.set(`${id}/${boards[i]}`, b));
        applyVideos(id, addVideos);
        added.add(id);
        draft = [];
        addVideos = [];
        renderAddVideos();
        dirty = true;
        addForm.reset(); addForm.hidden = true; addMsg.textContent = ''; renderDraft();
        catSelect.value = chapter;
        render();
      });

      // ---- Save & Publish: one fast-forward commit on main --------------------------------------
      $('[data-publish]').addEventListener('click', async () => {
        if (!dirty || busy) return;
        busy = true; render();
        status('Publishing… do not close this page.');
        try {
          validateFeatured();
          const ref = await gh(repo(`/git/ref/heads/${BRANCH}`));
          const head: string = ref.object.sha;
          const live = await gh(repo(`/contents/${DATA_PATH}?ref=${head}`));
          if (live.sha !== dataSha) throw new Error('The portfolio was changed on GitHub since this page loaded. Reload the page and redo your changes — nothing was published.');

          // Every board of a new or edited project must either exist on GitHub or be uploaded now, and an
          // upload must never land on an existing file.
          const used = referenced(data);
          const queue = [...uploads].filter(([key]) => used.has(key));
          const folders = new Set([...queue.map(([key]) => key.split('/')[0]!), ...[...boardsChanged, ...videosChanged].map((id) => data.projects[id]!.folder)]);
          for (const folder of folders) {
            const present = await listFolder(folder, head);
            for (const [key] of queue) if (key.startsWith(`${folder}/`) && present.has(key.slice(folder.length + 1)))
              throw new Error(`${key} already exists on GitHub and would be overwritten`);
            for (const key of used) if (key.startsWith(`${folder}/`) && !uploads.has(key) && !present.has(key.slice(folder.length + 1)))
              throw new Error(`the image ${key} is missing on GitHub`);
          }

          const tree: { path: string; mode: string; type: string; sha: string }[] = [];
          for (const [n, [key, b]] of queue.entries()) {
            status(`Uploading image ${n + 1} of ${queue.length}…`);
            const blob = await gh(repo('/git/blobs'), { method: 'POST', body: JSON.stringify({ content: await blobToB64(b.blob), encoding: 'base64' }) });
            tree.push({ path: `${ASSET_DIR}/${key}`, mode: '100644', type: 'blob', sha: blob.sha });
          }
          const json = JSON.stringify(data, null, 2) + '\n';
          const jsonBlob = await gh(repo('/git/blobs'), { method: 'POST', body: JSON.stringify({ content: json, encoding: 'utf-8' }) });
          tree.push({ path: DATA_PATH, mode: '100644', type: 'blob', sha: jsonBlob.sha });

          const base = await gh(repo(`/git/commits/${head}`));
          const newTree = await gh(repo('/git/trees'), { method: 'POST', body: JSON.stringify({ base_tree: base.tree.sha, tree }) });
          const names = (ids: Iterable<string>) => [...ids].map((id) => data.projects[id]!.client ?? data.projects[id]!.title).join(', ');
          const mv = [...moved.keys()].filter(isMoved);
          // Order compared without moved, added or deleted projects
          const sansMoved = (chs: string[][]) => JSON.stringify(chs.map((ps) => ps.filter((x) => !mv.includes(x) && !added.has(x) && data.projects[x])));
          const reordered = sansMoved(JSON.parse(loadedOrder)) !== sansMoved(data.chapters.map((c) => c.projects));
          const vis = Object.keys(data.projects).filter(visChanged);
          const hid = vis.filter((id) => data.projects[id]!.hidden), shown = vis.filter((id) => !data.projects[id]!.hidden);
          const message = `Portfolio manager: ${[added.size && `add ${names(added)}`, deleted.size && `delete ${[...deleted.values()].join(', ')}`,
            hid.length && `hide ${names(hid)}`, shown.length && `unhide ${names(shown)}`,
            mv.length && `move ${mv.map((id) => `${names([id])} to ${chapterOf(id)!.title}`).join(', ')}`, reordered && 'reorder projects', detailsChanged && 'edit project details', boardsChanged.size && `update boards of ${names(boardsChanged)}`, videosChanged.size && `update videos of ${names(videosChanged)}`, featuredChanged && 'update Selected Work'].filter(Boolean).join(', ') || 'update portfolio'}`;
          const commit = await gh(repo('/git/commits'), { method: 'POST', body: JSON.stringify({ message, tree: newTree.sha, parents: [head] }) });
          await gh(repo(`/git/refs/heads/${BRANCH}`), { method: 'PATCH', body: JSON.stringify({ sha: commit.sha, force: false }) });

          dataSha = jsonBlob.sha;
          for (const [key, b] of queue) { inRepo.add(key); previews.set(key, b.url); }
          uploads = new Map();
          added.clear();
          boardsChanged.clear();
          videosChanged.clear();
          dirty = false;
          featuredChanged = false;
          detailsChanged = false;
          moved.clear();
          deleted.clear();
          wasHidden.clear();
          for (const [id, p] of Object.entries(data.projects)) if (p.hidden) wasHidden.add(id);
          loadedOrder = order();
          busy = false;
          render();
          status('Saved to GitHub ✓ — the website is rebuilding (usually 2–3 minutes)…', 'ok');
          watchDeploy(commit.sha);
        } catch (e) {
          busy = false;
          render();
          const err = e as Error & { status?: number };
          status(err.status === 422 || err.status === 409
            ? 'GitHub refused the update because the repository changed meanwhile. Reload the page and try again — nothing was published.'
            : err.status === 403 || err.status === 404
              ? 'This token is not allowed to write to the repository (it needs Contents: Read and write). Nothing was published.'
              : `Publishing failed: ${err.message}. Nothing was published.`, 'err');
        }
      });

      // The public page carries the commit it was built from (<meta name="build">). Poll it (same origin,
      // cache-busted) until this commit is live. "Saved to GitHub" ≠ "live" until this confirms it.
      async function watchDeploy(sha: string) {
        const home = new URL('../', location.href);
        const t0 = Date.now();
        while (Date.now() - t0 < 10 * 60_000) {
          await new Promise((r) => setTimeout(r, 15_000));
          if (dirty || busy) return; // a newer edit/publish takes over the status line
          try {
            const html = await (await fetch(`${home.href}?build=${Date.now()}`, { cache: 'no-store' })).text();
            if (html.includes(`name="build" content="${sha}"`)) {
              status('Live deployment complete ✓ — the website now shows your changes.', 'ok');
              await cleanup();
              return;
            }
          } catch {}
          const min = Math.round((Date.now() - t0) / 60_000);
          status(`Saved to GitHub ✓ — the website is rebuilding${min ? ` (${min} min)` : ''}…`, 'ok');
        }
        if (!dirty && !busy) status(`Saved to GitHub ✓, but the website has not updated after 10 minutes. Check the Actions tab on GitHub (github.com/${OWNER}/${REPO}/actions).`, 'err');
      }

      // Removed and replaced board images stay on GitHub until the site without them is live. Then they
      // are deleted in a separate commit — only files that still exist and that the current
      // portfolio.json on GitHub no longer references. "[skip ci]": the website itself does not change.
      // If this fails or the page is closed first, the files simply stay (unused) in the repository.
      async function cleanup() {
        if (!toDelete.size || dirty || busy) return;
        const paths = [...toDelete];
        try {
          const head: string = (await gh(repo(`/git/ref/heads/${BRANCH}`))).object.sha;
          const used = referenced(JSON.parse(b64ToText((await gh(repo(`/contents/${DATA_PATH}?ref=${head}`))).content)));
          const gone: string[] = [];
          for (const folder of new Set(paths.map((k) => k.split('/')[0]!))) {
            const present = await listFolder(folder, head);
            for (const k of paths) if (k.startsWith(`${folder}/`) && present.has(k.slice(folder.length + 1)) && !used.has(k)) gone.push(k);
          }
          if (gone.length) {
            const base = await gh(repo(`/git/commits/${head}`));
            const tree = await gh(repo('/git/trees'), { method: 'POST', body: JSON.stringify({ base_tree: base.tree.sha, tree: gone.map((k) => ({ path: `${ASSET_DIR}/${k}`, mode: '100644', type: 'blob', sha: null })) }) });
            const commit = await gh(repo('/git/commits'), { method: 'POST', body: JSON.stringify({ message: `Portfolio manager: delete ${gone.length} unused board image${gone.length > 1 ? 's' : ''} [skip ci]`, tree: tree.sha, parents: [head] }) });
            await gh(repo(`/git/refs/heads/${BRANCH}`), { method: 'PATCH', body: JSON.stringify({ sha: commit.sha, force: false }) });
          }
          for (const k of paths) { toDelete.delete(k); if (!used.has(k)) inRepo.delete(k); }
          if (gone.length && !dirty && !busy) status(`Live deployment complete ✓ — the website now shows your changes. ${gone.length} unused board image${gone.length > 1 ? 's were' : ' was'} deleted from GitHub.`, 'ok');
        } catch {} // kept for the next publish to retry
      }

      // ---- Start --------------------------------------------------------------------------------
      const saved = store.get();
      if (saved) signIn(saved, null);
    </script>

    <style is:global>
      body { min-height: 100vh; background: var(--ink); color: var(--cream); }
