---
// /portfolio/ — the old entry point. Sends visitors to the English site, keeping any #section from
// older links (e.g. /portfolio/#contact → /portfolio/en/#contact). No language detection: the
// language is always the one in the URL.
// It also carries the build meta: the portfolio manager (/admin/) polls this page to report when a
// publish is live.
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const target = `${base}en/`;
const build: string | undefined = import.meta.env.GITHUB_SHA;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Marwen Dridi — Portfolio</title>
    {build && <meta name="build" content={build} />}
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <meta name="theme-color" content="#000004" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <script is:inline define:vars={{ target }}>location.replace(target + location.search + location.hash);</script>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <style>body { margin: 0; background: #000004; color: #fff5ea; font: 1rem/1.6 system-ui, sans-serif; } a { color: #00a0de; } p { padding: 24px; }</style>
  </head>
  <body>
    <p><a href={target}>Marwen Dridi — Portfolio (English)</a> · <a href={`${base}fr/`}>Version française</a></p>
  </body>
</html>
