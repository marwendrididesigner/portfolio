---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SocialProof from '../components/SocialProof.astro';
import Credentials from '../components/Credentials.astro';
import Ribbon from '../components/Ribbon.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Work from '../components/Work.astro';
import Contact from '../components/Contact.astro';
import BackToTop from '../components/BackToTop.astro';
import Motion from '../components/Motion.astro';
---
<Layout
  title="Marwen Dridi — Senior Graphic Designer | Brand Identity, Editorial & Presentation Design"
  description="Marwen Dridi is a senior graphic designer in Tunis with 8+ years of experience in brand identities, bilingual Arabic/Latin brand guidelines, company profiles, pitch decks, reports and social media campaigns for clients in 15 countries."
>
  <Header />
  <main>
    <Hero />
    <SocialProof />
    <SelectedWork />
    <Work />
    <Ribbon from="var(--paper)" to="var(--ink-2)" />
    <Credentials />
    <Contact />
  </main>
  <BackToTop />
  <Motion />
</Layout>
