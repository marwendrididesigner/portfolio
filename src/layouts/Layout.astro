---
import '@fontsource/argentum-sans/latin-400.css';
import '@fontsource/argentum-sans/latin-800.css';
import font400 from '@fontsource/argentum-sans/files/argentum-sans-latin-400-normal.woff2?url';
import font800 from '@fontsource/argentum-sans/files/argentum-sans-latin-800-normal.woff2?url';
import '../styles/global.css';
import { copy, person } from '../data/site';
import { langs, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const { title, description } = t.meta;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Each language is its own indexable page: canonical to itself, hreflang to both, x-default → English.
const pageUrl = (l: Lang) => new URL(`${base}${l}/`, Astro.site);
const canonical = pageUrl(lang);
const ogImage = new URL(`${base}og.jpg`, Astro.site);
// Commit this build was made from (set by GitHub Actions). The portfolio manager polls for it to
// report when a publish is actually live.
const build: string | undefined = import.meta.env.GITHUB_SHA;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: copy[lang].role,
  email: `mailto:${person.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Tunis', addressCountry: 'TN' },
  url: canonical.href,
};
---
<!doctype html>
<html lang={t.htmlLang} class="jump">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={pageUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={pageUrl('en')} />
    <meta name="theme-color" content="#000004" />
    {build && <meta name="build" content={build} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preload" href={font800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font400} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.ogLocale} />
    {langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ui[l].ogLocale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script is:inline>addEventListener('load', () => requestAnimationFrame(() => document.documentElement.classList.remove('jump')));</script>
  </head>
  <body>
    <a class="skip-link" href="#selected-work">{t.skip}</a>
    <slot />
  </body>
</html>
