---
import { certifications, languages, tools } from '../data/site';
---
<section class="credentials" id="credentials" aria-labelledby="credentials-title">
  <div class="container">
    <header>
      <p class="eyebrow">Credentials</p>
      <h2 id="credentials-title" class="title">Tools, certifications &amp; languages</h2>
    </header>

    <div class="grid">
      <div class="tools">
        <h3 class="label">Software &amp; platforms</h3>
        {tools.map((t) => (
          <div class="group">
            <h4>{t.group}</h4>
            <ul class="tags">{t.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>

      <div class="side">
        <h3 class="label">Certifications</h3>
        <ol class="certs">
          {certifications.map((c) => (
            <li>
              <span class="cert-name">{c.name}</span>
              <span class="cert-meta">{c.issuer} · <time datetime={c.iso}>{c.date}</time></span>
            </li>
          ))}
        </ol>

        <h3 class="label lang-label">Languages</h3>
        <dl class="langs">
          {languages.map((l) => (
            <div><dt>{l.name}</dt><dd>{l.level}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .credentials { padding-block: clamp(64px, 8vw, 112px) clamp(56px, 7vw, 96px); background: var(--ink-2); }
  .title {
    margin-top: 12px;
    font-size: clamp(1.625rem, 2.9vw, 2.5rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.01em;
  }
  .grid {
    display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(40px, 6vw, 96px); margin-top: clamp(28px, 4vw, 48px);
  }
  .label {
    margin: 0 0 16px; padding-bottom: 10px; border-bottom: 1px solid var(--rule-dark);
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.26em; text-transform: uppercase; color: var(--blue);
  }

  .group + .group { margin-top: 22px; }
  h4 {
    margin: 0 0 10px; font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.24em;
    text-transform: uppercase; color: var(--cream-dim);
  }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  .tags li {
    font-size: 0.875rem; line-height: 1.2; padding: 8px 13px;
    border: 1px solid rgb(255 245 234 / 0.22); background: rgb(255 245 234 / 0.035);
  }

  .certs { list-style: none; margin: 0; padding: 0; }
  .certs li {
    display: grid; gap: 2px; padding: 12px 0;
    border-bottom: 1px solid var(--rule-dark);
  }
  .certs li:first-child { padding-top: 0; }
  .cert-name { font-size: 0.9375rem; line-height: 1.4; }
  .cert-meta { font-size: 0.8125rem; color: var(--cream-dim); }

  .lang-label { margin-top: 36px; }
  .langs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0; }
  .langs div { display: grid; gap: 2px; }
  .langs dt { font-size: 1rem; font-weight: 800; }
  .langs dd { margin: 0; font-size: 0.8125rem; color: var(--cream-dim); }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .tags li { font-size: 0.8125rem; padding: 7px 11px; }
    .langs { grid-template-columns: 1fr 1fr; }
  }
</style>
