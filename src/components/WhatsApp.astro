---
import { person } from '../data/site';
import { langOf, ui } from '../i18n/ui';

// Discreet floating WhatsApp link, bottom-right (the back-to-top button sits above it).
// Desktop pointers see "Message me" slide out on hover/focus; phones keep the icon only.
const t = ui[langOf(Astro.url)].whatsapp;
const href = `${person.whatsapp}?text=${encodeURIComponent(t.message)}`;
---
<a class="wa-float" href={href} target="_blank" rel="noopener noreferrer" aria-label={t.label}>
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z"/></svg>
  <span class="wa-label" aria-hidden="true">{t.short}</span>
</a>

<style>
  .wa-float {
    --edge: clamp(16px, 2.5vw, 32px);
    position: fixed; z-index: 90;
    right: calc(var(--edge) + env(safe-area-inset-right));
    bottom: calc(var(--edge) + env(safe-area-inset-bottom));
    display: flex; align-items: center; height: 48px; min-width: 48px; padding-inline: 13px;
    border-radius: 24px; border: 1px solid var(--rule-dark);
    background: var(--ink); color: #25d366; /* WhatsApp green, as a restrained accent on the icon */
    text-decoration: none;
    box-shadow: 0 8px 24px -12px rgb(0 0 4 / 0.5);
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }
  .wa-float svg { flex: none; }
  .wa-label {
    max-width: 0; overflow: hidden; white-space: nowrap; opacity: 0;
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cream);
    transition: max-width 0.3s var(--ease), opacity 0.2s var(--ease), margin 0.3s var(--ease);
  }
  .wa-float:hover, .wa-float:focus-visible { border-color: #25d366; }
  @media (hover: hover) and (min-width: 960px) {
    .wa-float:hover .wa-label, .wa-float:focus-visible .wa-label { max-width: 140px; opacity: 1; margin: 0 4px 0 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float, .wa-label { transition: none; }
  }
</style>
