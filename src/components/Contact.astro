---
import { copy, person } from '../data/site';
import { langOf, ui } from '../i18n/ui';

const lang = langOf(Astro.url);
const t = ui[lang].contact;
const c = copy[lang];
const year = new Date().getFullYear();
const quickMessage = `${person.whatsapp}?text=${encodeURIComponent(c.whatsappMessage)}`;
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2 id="contact-title" class="title">{c.contact.heading}</h2>
    <p class="lede">{c.contact.text}</p>

    <ul class="channels">
      <li>
        <span class="k">{t.email}</span>
        <a href={`mailto:${person.email}`}>{person.email}</a>
      </li>
      <li>
        <span class="k">WhatsApp</span>
        <a href={person.whatsapp} target="_blank" rel="noopener noreferrer">
          {person.phoneDisplay}<span class="visually-hidden">{t.opensWhatsApp}</span>
        </a>
      </li>
      <li>
        <span class="k">Portfolio</span>
        <a href={person.portfolioPdf} target="_blank" rel="noopener">
          {t.pdf} <span aria-hidden="true">↗</span><span class="visually-hidden">{t.pdfHint}</span>
        </a>
      </li>
    </ul>

    <div class="actions">
      <a class="btn btn--primary" href={`mailto:${person.email}`}>{t.sendEmail} <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" href={quickMessage} target="_blank" rel="noopener noreferrer">
        <svg class="wa" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2Zm0 18.15a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 4.54 0 8.24 3.7 8.24 8.24 0 4.55-3.7 8.24-8.24 8.24Zm4.52-6.17c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.29Z"/></svg>
        {t.quick}<span class="visually-hidden">{t.newTab}</span>
      </a>
    </div>
  </div>

  <footer class="container foot">
    <p>© {year} {person.name} · {c.role}</p>
    <p>{c.location}</p>
  </footer>
</section>

<style>
  .contact {
    position: relative; overflow: hidden;
    padding-top: clamp(80px, 12vw, 160px);
    background:
      radial-gradient(60% 70% at 100% 0%, rgb(0 76 138 / 0.55), transparent 70%),
      var(--ink);
  }
  .title {
    margin-top: 16px; max-width: 16ch;
    font-size: clamp(2.25rem, 5.6vw, 4.75rem); font-weight: 800; line-height: 1.02; letter-spacing: -0.015em;
  }
  .lede { margin-top: 20px; max-width: 52ch; font-size: clamp(1rem, 1.4vw, 1.1875rem); color: var(--cream-dim); }

  .channels { list-style: none; margin: clamp(40px, 6vw, 72px) 0 0; padding: 0; border-top: 1px solid var(--rule-dark); }
  .channels li {
    display: grid; grid-template-columns: minmax(110px, 200px) 1fr; gap: 16px; align-items: baseline;
    padding: 20px 0; border-bottom: 1px solid var(--rule-dark);
  }
  .k { font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.3em; text-transform: uppercase; color: var(--cream-dim); }
  .channels a {
    font-size: clamp(1.125rem, 2.6vw, 2rem); font-weight: 400; text-decoration: none;
    overflow-wrap: anywhere; transition: color 0.2s var(--ease);
  }
  .channels a:hover { color: var(--blue); }
  .actions { display: flex; flex-wrap: wrap; gap: 12px 16px; margin-top: 40px; }
  .wa { flex: none; }

  .foot {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    margin-top: clamp(80px, 10vw, 140px); padding-block: 24px;
    border-top: 1px solid var(--rule-dark);
    font-size: 0.8125rem; color: var(--cream-dim);
  }
  @media (max-width: 560px) {
    .channels li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
