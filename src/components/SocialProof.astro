---
import { copy, metrics } from '../data/site';
import { langOf, ui } from '../i18n/ui';
const lang = langOf(Astro.url);
// Compact social-proof strip between the hero and the portfolio — numbers only, no intro copy.
---
<section class="proof" aria-label={ui[lang].proof.label} data-proof>
  <div class="container">
    <dl class="stats">
      {metrics.map((value, i) => (
        <div class="stat">
          <dt>{copy[lang].metrics[i]}</dt>
          <dd><span class="num" data-count={value}>{value}</span><span class="plus">+</span></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .proof {
    background: var(--blue);
    color: #fff;
    padding-block: clamp(28px, 3.4vw, 44px);
  }
  .stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }
  .stat {
    display: flex; flex-direction: column; gap: 6px;
    padding-inline: clamp(16px, 3vw, 40px);
    border-left: 1px solid rgb(255 255 255 / 0.3);
  }
  .stat:first-child { padding-left: 0; border-left: 0; }
  /* Number first visually, top-aligned so wrapped labels never shift it */
  dd {
    order: -1; margin: 0;
    font-size: clamp(2.25rem, 4vw, 3.5rem); font-weight: 800; line-height: 1; letter-spacing: -0.02em;
  }
  /* Counting numbers are right-aligned in their final width (set by Motion.astro), so "+" stays put */
  .num { display: inline-block; text-align: right; font-variant-numeric: tabular-nums; }
  .plus { margin-left: 0.04em; font-weight: 400; }
  dt {
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; line-height: 1.5;
    color: #fff;
  }

  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px 0; }
    .stat:nth-child(odd) { padding-left: 0; border-left: 0; }
    .stat:nth-child(even) { padding-left: 20px; }
    dt { font-size: 0.6875rem; letter-spacing: 0.12em; }
  }
</style>
