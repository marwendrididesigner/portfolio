---
import { metrics } from '../data/site';
// Compact social-proof strip between the hero and the portfolio — numbers only, no intro copy.
---
<section class="proof" aria-label="Key figures">
  <div class="container">
    <dl class="stats">
      {metrics.map((m) => (
        <div class="stat">
          <dt>{m.label}</dt>
          <dd>{m.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .proof {
    background: var(--ink);
    border-top: 1px solid var(--rule-dark);
    padding-block: clamp(28px, 3.6vw, 48px);
  }
  .stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
  }
  .stat {
    display: flex; flex-direction: column; gap: 8px;
    padding-inline: clamp(16px, 3vw, 40px);
    border-left: 1px solid var(--rule-dark);
  }
  .stat:first-child { padding-left: 0; border-left: 0; }
  /* Number first visually, top-aligned so wrapped labels never shift it */
  dd {
    order: -1; margin: 0; color: var(--blue);
    font-size: clamp(2rem, 3.6vw, 3rem); font-weight: 800; line-height: 1; letter-spacing: -0.01em;
  }
  dt {
    font-size: 0.75rem; font-weight: 400; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--cream-dim); line-height: 1.5;
  }

  @media (max-width: 760px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px 0; }
    .stat:nth-child(odd) { padding-left: 0; border-left: 0; }
    .stat:nth-child(even) { padding-left: 20px; }
    dt { font-size: 0.6875rem; letter-spacing: 0.12em; }
  }
</style>
