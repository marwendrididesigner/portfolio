---
import { categories } from '../data/projects';
import { chapters } from '../data/portfolio';
const withWork = new Set(chapters.map((c) => c.id));
---
<section class="services" id="services" aria-labelledby="services-title">
  <div class="container">
    <header class="head">
      <p class="eyebrow">Services</p>
      <h2 id="services-title" class="title">Services &amp; deliverables</h2>
    </header>

    <ol class="list">
      {categories.map((c) => (
        <li class="item">
          <h3><span class="num">{c.number}</span>{c.title}</h3>
          <ul class="deliv">
            {c.deliverables.map((d) => <li>{d}</li>)}
          </ul>
          {withWork.has(c.id) && (
            <a class="see" href={`#work-${c.id}`}>
              See work <span aria-hidden="true">→</span><span class="visually-hidden"> in {c.title}</span>
            </a>
          )}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services { padding-block: clamp(56px, 7vw, 96px) clamp(40px, 5vw, 72px); background: var(--ink-2); }
  .title {
    margin-top: 12px;
    font-size: clamp(1.625rem, 2.9vw, 2.5rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.01em;
  }

  .list {
    list-style: none; margin: clamp(28px, 4vw, 48px) 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(32px, 5vw, 80px);
  }
  .item { padding: 22px 0 24px; border-top: 1px solid var(--rule-dark); }
  h3 {
    display: flex; align-items: baseline; gap: 14px; margin: 0;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem); font-weight: 800; line-height: 1.3;
  }
  .num { color: var(--blue); font-size: 0.8125rem; letter-spacing: 0.16em; flex: none; width: 2.2rem; }

  .deliv {
    list-style: none; margin: 10px 0 0 calc(2.2rem + 14px); padding: 0;
    display: flex; flex-wrap: wrap; gap: 2px 0;
    font-size: 0.9375rem; line-height: 1.6; color: var(--cream-dim);
  }
  /* Separator trails each item, so wrapped lines never start with a dot */
  .deliv li:not(:last-child)::after { content: '·'; margin-inline: 0.55em; color: var(--blue); }

  .see {
    display: inline-flex; gap: 6px; margin: 12px 0 0 calc(2.2rem + 14px);
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--blue); text-decoration: none;
  }
  .see span[aria-hidden] { transition: transform 0.2s var(--ease); }
  .see:hover { color: var(--cream); }
  .see:hover span[aria-hidden] { transform: translateX(3px); }

  @media (max-width: 760px) {
    .list { grid-template-columns: 1fr; }
    .deliv, .see { margin-left: 0; }
  }
</style>
