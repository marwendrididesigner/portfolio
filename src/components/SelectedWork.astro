---
import { Image } from 'astro:assets';
import { chapters, featured, rowsOf } from '../data/portfolio';
import { chapterTitle, country, groupTitle, langOf, services, projectText, ui } from '../i18n/ui';

const lang = langOf(Astro.url);
const t = ui[lang].selected;
const w = ui[lang].work;

// Selected Work: a short introduction to the portfolio — five groups (portfolio.json → "featured",
// managed from /admin/) of up to four projects. Each project shows only its SELECTED boards, in the
// chosen order; the full portfolio below still shows every board. Projects are the same records the
// full portfolio renders; nothing is duplicated.
// Layout follows the full portfolio: one project per row with its boards two per row from 760 px
// (two consecutive single-board projects share a row), one column on phones, never cropped.
// Each board opens the shared viewer (Work.astro), which walks only that project's selected boards.

// Same widths/format/quality as Work.astro, so the build reuses the exact same image files.
const SIZES = '(min-width: 1440px) 648px, (min-width: 760px) 45vw, 91vw';
// Packaging is only named once it has featured work (empty groups are not rendered)
const packaging = featured.some((g) => g.chapter.id === 'packaging');
---
{featured.length > 0 && (
<section class="selected" id="selected-work" aria-labelledby="selected-title">
  <div class="container">
    <header class="sel-intro">
      <h2 id="selected-title" class="sel-title">{t.title}</h2>
      <p class="sel-lede">{t.lede(packaging)}</p>
    </header>

    {featured.map((g) => (
      <section class="group" aria-labelledby={`sel-${g.id}`}>
        <header class="group-head">
          <p class="group-num">{g.number}</p>
          <h3 id={`sel-${g.id}`} class="group-title">{groupTitle(lang, g.id, g.title)}</h3>
        </header>

        <div class="projects">
          {rowsOf(g.projects).map((row) => (
            <div class={row.length === 2 ? 'row pair' : 'row'}>
              {row.map((p) => {
                const client = projectText(lang, p.client), title = p.title && projectText(lang, p.title);
            const name = [client, title].filter(Boolean).join(' — ');
                const n = p.boards.length;
                const meta = [p.country && country(lang, p.country), p.services ? services(lang, p.services) : chapterTitle(lang, p.chapter, chapters.find((c) => c.id === p.chapter)!.title)].filter(Boolean).join(' · '); // the project's own section
                return (
                  <article class="project" aria-labelledby={`sel-title-${g.id}-${p.id}`}>
                    <header class="project-head">
                      <h4 id={`sel-title-${g.id}-${p.id}`} class="client">{client}{title && <span class="ptitle"> — {title}</span>}</h4>
                      <p class="meta">{meta}</p>
                    </header>
                    <div class="boards">
                      {p.boards.map((v, i) => (
                        <button type="button" class="board"
                          data-viewer data-viewer-set={`${g.id}/${p.id}`} data-project={name} data-pos={`${i + 1} / ${n}`}>
                          <Image src={v.src} alt={lang === 'fr' ? v.altFr : v.alt} widths={[640, 960, 1400, 1920]}
                            sizes={SIZES} format="webp" quality={82} loading="lazy" decoding="async" />
                          <span class="zoom" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M10.5 3a7.5 7.5 0 0 1 5.96 12.05l4.5 4.5-1.41 1.41-4.5-4.5A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Zm1 2.5v2h2v2h-2v2h-2v-2h-2v-2h2v-2h2Z" fill="currentColor"/></svg>
                          </span>
                          <span class="visually-hidden">{w.open}</span>
                        </button>
                      ))}
                    </div>
                  </article>
                );
              })}
            </div>
          ))}
        </div>

        <a class="explore" href={`#work-${g.chapter.id}`}>{t.explore(chapterTitle(lang, g.chapter.id, g.chapter.title))} <span aria-hidden="true">→</span></a>
      </section>
    ))}

    <header class="full-intro">
      <h2 class="full-title">{t.fullTitle}</h2>
      <p class="sel-lede">{t.fullLede}</p>
    </header>
  </div>
</section>
)}

<style>
  .selected { background: var(--paper); color: var(--ink); padding-top: clamp(48px, 6vw, 88px); scroll-margin-top: calc(var(--header-h) + var(--catnav-h)); }

  .sel-intro { margin-bottom: clamp(32px, 4vw, 56px); }
  .sel-title, .full-title {
    font-size: clamp(2rem, 4.4vw, 3.5rem); font-weight: 800; line-height: 1.04;
    letter-spacing: 0.02em; text-transform: uppercase;
  }
  .sel-lede { margin-top: 10px; max-width: 60ch; font-size: clamp(0.9375rem, 1.2vw, 1.0625rem); line-height: 1.6; color: var(--label); }

  .group + .group { margin-top: clamp(56px, 7vw, 96px); }
  .group-head {
    display: flex; align-items: baseline; gap: 14px;
    padding-bottom: clamp(12px, 1.5vw, 18px); margin-bottom: clamp(20px, 2.5vw, 32px);
    border-bottom: 1px solid var(--rule-light);
  }
  .group-num { color: var(--blue); font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.24em; }
  .group-title { font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.005em; }

  /* Same rules as the full portfolio (Work.astro): one project per row, its boards two per row from
     760 px, consecutive single-board projects paired, one column on phones */
  .projects { display: flex; flex-direction: column; gap: clamp(40px, 5vw, 64px); }
  .project-head { margin-bottom: 12px; }
  .client { margin: 0; font-size: clamp(1.0625rem, 1.5vw, 1.25rem); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.25; }
  .ptitle { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--label); }
  .meta { margin-top: 4px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--value); }

  .boards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-items: start; }
  @media (min-width: 760px) {
    .boards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
    .pair .boards { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 759px) { .pair { display: flex; flex-direction: column; gap: clamp(40px, 5vw, 64px); } }

  .board {
    position: relative; display: block; width: 100%; padding: 0; border: 0; background: none;
    cursor: zoom-in; overflow: hidden; transition: box-shadow 0.25s var(--ease);
  }
  .board :global(img) { display: block; width: 100%; height: auto; box-shadow: inset 0 0 0 1px var(--rule-light); }
  .board:hover { box-shadow: 0 10px 28px -12px rgb(0 0 4 / 0.28); }
  .board:focus-visible { outline-offset: 2px; }
  .zoom {
    position: absolute; top: 10px; right: 10px;
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: rgb(0 0 4 / 0.72); color: var(--cream);
    opacity: 0; transform: scale(0.85);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .board:hover .zoom, .board:focus-visible .zoom { opacity: 1; transform: none; }
  @media (hover: none) { .zoom { opacity: 0.85; transform: none; width: 28px; height: 28px; top: 8px; right: 8px; } }

  .explore {
    display: inline-flex; align-items: center; gap: 8px; margin-top: clamp(24px, 3vw, 36px);
    padding-block: 10px 4px; font-size: 0.875rem; font-weight: 800; letter-spacing: 0.06em; color: var(--ink);
    text-decoration: none; border-bottom: 1px solid var(--blue);
    transition: color 0.2s var(--ease);
  }
  .explore span { color: var(--blue); transition: transform 0.2s var(--ease); }
  .explore:hover { color: var(--blue); }
  .explore:hover span { transform: translateX(3px); }

  /* Transition into the complete portfolio (Work follows directly, with its own top padding) */
  .full-intro {
    margin-top: clamp(72px, 9vw, 128px); padding-top: clamp(32px, 4vw, 48px);
    border-top: 2px solid var(--ink);
  }
</style>
