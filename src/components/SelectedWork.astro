---
import { Image } from 'astro:assets';
import { featured } from '../data/portfolio';

// Selected Work: a short introduction to the portfolio — four groups (portfolio.json → "featured",
// managed from /admin/) of up to four projects, each shown by its first board. Projects are the same
// records the full portfolio renders below; nothing is duplicated, and they stay in the full portfolio.
// Two projects per row from 760 px, one on phones; boards keep their original proportions.
// Clicking a card opens the shared viewer (Work.astro) at that project's first board, so its other
// boards follow with → / swipe.

// Same widths/format/quality as Work.astro, so the build reuses the exact same image files.
const SIZES = '(min-width: 1440px) 648px, (min-width: 760px) 45vw, 91vw';
---
{featured.length > 0 && (
<section class="selected" id="selected-work" aria-labelledby="selected-title">
  <div class="container">
    <header class="sel-intro">
      <h2 id="selected-title" class="sel-title">Selected Work</h2>
      <p class="sel-lede">A selection of brand identities, campaigns, editorial design, and AI-powered visuals.</p>
    </header>

    {featured.map((g) => (
      <section class="group" aria-labelledby={`sel-${g.id}`}>
        <header class="group-head">
          <p class="group-num">{g.number}</p>
          <h3 id={`sel-${g.id}`} class="group-title">{g.title}</h3>
        </header>

        <div class="sel-grid">
          {g.projects.map((p) => {
            const n = p.boards.length;
            const meta = [p.country, p.services ?? g.chapter.title, n > 1 ? `${n} boards` : ''].filter(Boolean).join(' · ');
            return (
              <article class="card">
                <button type="button" class="card-board" data-viewer-open={p.id}
                  aria-label={`Open ${[p.client, p.title].filter(Boolean).join(' — ')} in the viewer`}>
                  <Image src={p.boards[0]!.src} alt={p.boards[0]!.alt} widths={[640, 960, 1400, 1920]}
                    sizes={SIZES} format="webp" quality={82} loading="lazy" decoding="async" />
                  <span class="zoom" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="16" height="16"><path d="M10.5 3a7.5 7.5 0 0 1 5.96 12.05l4.5 4.5-1.41 1.41-4.5-4.5A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Zm1 2.5v2h2v2h-2v2h-2v-2h-2v-2h2v-2h2Z" fill="currentColor"/></svg>
                  </span>
                </button>
                <h4 class="card-name">{p.client}{p.title && <span class="ptitle"> — {p.title}</span>}</h4>
                <p class="card-meta">{meta}</p>
              </article>
            );
          })}
        </div>

        <a class="explore" href={`#work-${g.chapter.id}`}>Explore all {g.chapter.title} projects <span aria-hidden="true">→</span></a>
      </section>
    ))}

    <header class="full-intro">
      <h2 class="full-title">Full Portfolio</h2>
      <p class="sel-lede">Explore the complete collection of projects.</p>
    </header>
  </div>
</section>
)}

<style>
  .selected { background: var(--paper); color: var(--ink); padding-top: clamp(48px, 6vw, 88px); scroll-margin-top: var(--header-h); }

  .sel-intro { margin-bottom: clamp(32px, 4vw, 56px); }
  .sel-title, .full-title {
    font-size: clamp(2rem, 4.4vw, 3.5rem); font-weight: 800; line-height: 1.04;
    letter-spacing: 0.02em; text-transform: uppercase;
  }
  .sel-lede { margin-top: 10px; max-width: 60ch; font-size: clamp(0.9375rem, 1.2vw, 1.0625rem); line-height: 1.6; color: var(--label); }

  .group + .group { margin-top: clamp(56px, 7vw, 96px); }
  .group-head {
    display: flex; align-items: baseline; gap: 14px;
    padding-bottom: clamp(12px, 1.5vw, 18px); margin-bottom: clamp(20px, 2.5vw, 32px);
    border-bottom: 1px solid var(--rule-light);
  }
  .group-num { color: var(--blue); font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.24em; }
  .group-title { font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.005em; }

  /* Two projects per row from 760 px (two rows of two), one per row on phones */
  .sel-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 4vw, 48px) 16px; align-items: start; }
  @media (min-width: 760px) { .sel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .card-board {
    position: relative; display: block; width: 100%; padding: 0; border: 0; background: none;
    cursor: zoom-in; overflow: hidden; transition: box-shadow 0.25s var(--ease);
  }
  .card-board :global(img) { display: block; width: 100%; height: auto; box-shadow: inset 0 0 0 1px var(--rule-light); }
  .card-board:hover { box-shadow: 0 10px 28px -12px rgb(0 0 4 / 0.28); }
  .card-board:focus-visible { outline-offset: 2px; }
  .zoom {
    position: absolute; top: 10px; right: 10px;
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: rgb(0 0 4 / 0.72); color: var(--cream);
    opacity: 0; transform: scale(0.85);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .card-board:hover .zoom, .card-board:focus-visible .zoom { opacity: 1; transform: none; }
  @media (hover: none) { .zoom { opacity: 0.85; transform: none; width: 28px; height: 28px; top: 8px; right: 8px; } }

  .card-name {
    margin: 14px 0 0;
    font-size: clamp(1rem, 1.4vw, 1.125rem); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.25;
  }
  .ptitle { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--label); }
  .card-meta { margin-top: 4px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--value); }

  .explore {
    display: inline-flex; align-items: center; gap: 8px; margin-top: clamp(24px, 3vw, 36px);
    padding-block: 10px 4px; font-size: 0.875rem; font-weight: 800; letter-spacing: 0.06em; color: var(--ink);
    text-decoration: none; border-bottom: 1px solid var(--blue);
    transition: color 0.2s var(--ease);
  }
  .explore span { color: var(--blue); transition: transform 0.2s var(--ease); }
  .explore:hover { color: var(--blue); }
  .explore:hover span { transform: translateX(3px); }

  /* Transition into the complete portfolio (Work follows directly, with its own top padding) */
  .full-intro {
    margin-top: clamp(72px, 9vw, 128px); padding-top: clamp(32px, 4vw, 48px);
    border-top: 2px solid var(--ink);
  }
</style>
