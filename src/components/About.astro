---
import { about, metrics } from '../data/site';
// The confirmed headline metric (8+ years) is the large outlined figure; the others follow in the row.
const [years, ...rest] = metrics;
---
<section class="about" id="about" aria-labelledby="about-title">
  <div class="container grid">
    <dl class="hero-metric">
      <dt>{years!.label}</dt>
      <dd class="outlined big">{years!.value}</dd>
    </dl>
    <div class="copy">
      <p class="eyebrow">About</p>
      <h2 id="about-title" class="title">{about.heading}</h2>
      {about.paragraphs.map((p) => <p class="text">{p}</p>)}
      <dl class="metrics">
        {rest.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(72px, 9vw, 128px) clamp(56px, 7vw, 96px);
    background: linear-gradient(180deg, var(--ink) 0%, var(--ink-2) 100%);
  }
  .grid {
    display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 6vw, 96px); align-items: start;
  }

  .hero-metric {
    margin: 0; display: flex; flex-direction: column-reverse; gap: 18px;
    padding-top: 8px;
  }
  .big {
    margin: 0;
    font-size: clamp(8rem, 19vw, 17rem);
    -webkit-text-stroke-width: 2px;
  }
  .hero-metric dt {
    font-size: 0.75rem; font-weight: 800; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--cream-dim);
    padding-left: 14px; border-left: 1.5px solid var(--blue);
  }

  .title {
    margin: 16px 0 24px; max-width: 22ch;
    font-size: clamp(1.625rem, 2.9vw, 2.5rem); font-weight: 800; line-height: 1.12; letter-spacing: -0.01em;
  }
  .text { max-width: 58ch; color: var(--cream-dim); font-size: 1.0625rem; line-height: 1.65; }
  .text + .text { margin-top: 14px; }
  .text:first-of-type { color: var(--cream); }

  .metrics {
    display: grid; grid-template-columns: repeat(2, minmax(0, 240px)); gap: 0 32px;
    margin: 36px 0 0; border-top: 1px solid var(--rule-dark);
  }
  .metrics div { padding-top: 20px; display: flex; flex-direction: column-reverse; gap: 6px; }
  .metrics dd { margin: 0; font-size: clamp(2.25rem, 4vw, 3rem); font-weight: 800; color: var(--blue); line-height: 1; }
  .metrics dt { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cream-dim); }

  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr; gap: 28px; }
    .hero-metric { flex-direction: row-reverse; justify-content: flex-end; align-items: flex-end; gap: 20px; padding-top: 0; }
    .big { font-size: 7.5rem; }
    .hero-metric dt { margin-bottom: 14px; max-width: 9ch; line-height: 1.5; }
    .metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 20px; }
  }
</style>
