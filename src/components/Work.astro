---
import { Image } from 'astro:assets';
import { chapters } from '../data/portfolio';

// Portfolio in the PDF's order: chapter introduction → its projects, ONE project per full-width row.
// Inside a project the boards fill a two-column grid from 760 px (1st left, 2nd right, 3rd next row
// left…); an odd count leaves the last right-hand cell empty — the next project always starts below.
// One column on phones. Boards keep their original aspect ratio — never cropped.
// Exception: two CONSECUTIVE single-board projects in the same chapter share a row (side by side
// from 760 px, stacked on phones); a single-board project without such a neighbour stays alone.
// Every board is also a button that opens the viewer, which walks the whole portfolio in this order.

// `sizes` can't use CSS variables: the gutter is ~4.5vw, the board gap 16px.
const SIZES = '(min-width: 1440px) 648px, (min-width: 760px) 45vw, 91vw';

type Project = (typeof chapters)[number]['projects'][number];
const rowsOf = (projects: Project[]) => {
  const rows: Project[][] = [];
  for (let i = 0; i < projects.length; i++) {
    const p = projects[i]!, q = projects[i + 1];
    if (p.boards.length === 1 && q?.boards.length === 1) { rows.push([p, q]); i++; }
    else rows.push([p]);
  }
  return rows;
};
---
<section class="work" id="work" aria-label="Portfolio">
  <div class="container">
    {chapters.map((c) => (
      <section class="chapter" id={`work-${c.id}`} aria-labelledby={`chapter-${c.id}`}>
        <header class="chapter-head">
          <p class="chapter-num">{c.number}</p>
          <h2 id={`chapter-${c.id}`} class="chapter-title">{c.title}</h2>
          {c.deliverables.length > 0 && (
            <ul class="deliv" aria-label="Deliverables">
              {c.deliverables.map((d) => <li>{d}</li>)}
            </ul>
          )}
        </header>

        <div class="projects">
          {rowsOf(c.projects).map((row) => (
          <div class={row.length === 2 ? 'row pair' : 'row'}>
          {row.map((p) => {
            const name = [p.client, p.title].filter(Boolean).join(' — ');
            const n = p.boards.length;
            return (
              <article class="project" id={p.id} aria-labelledby={`title-${p.id}`}>
                <header class="project-head">
                  <h3 id={`title-${p.id}`} class="client">{p.client}{p.title && <span class="ptitle"> — {p.title}</span>}</h3>
                  {(p.country || p.services) && (
                    <p class="meta">{[p.country, p.services].filter(Boolean).join(' · ')}</p>
                  )}
                </header>
                <div class="boards">
                  {p.boards.map((v, i) => {
                    return (
                      <button type="button" class="board"
                        data-viewer data-project={name} data-pos={`${i + 1} / ${n}`}>
                        <Image src={v.src} alt={v.alt} widths={[640, 960, 1400, 1920]}
                          sizes={SIZES}
                          format="webp" quality={82} loading="lazy" decoding="async" />
                        <span class="zoom" aria-hidden="true">
                          <svg viewBox="0 0 24 24" width="16" height="16"><path d="M10.5 3a7.5 7.5 0 0 1 5.96 12.05l4.5 4.5-1.41 1.41-4.5-4.5A7.5 7.5 0 1 1 10.5 3Zm0 2a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11Zm1 2.5v2h2v2h-2v2h-2v-2h-2v-2h2v-2h2Z" fill="currentColor"/></svg>
                        </span>
                        <span class="visually-hidden">Open larger view</span>
                      </button>
                    );
                  })}
                </div>
              </article>
            );
          })}
          </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <dialog class="viewer" aria-labelledby="viewer-title" data-viewer-dialog>
    <div class="v-bar">
      <p class="v-info"><span id="viewer-title" class="v-title" data-v-title></span><span class="v-pos" data-v-pos></span></p>
      <button type="button" class="v-btn v-close" data-v-close aria-label="Close viewer">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6.4 5 12 10.6 17.6 5 19 6.4 13.4 12l5.6 5.6-1.4 1.4-5.6-5.6L6.4 19 5 17.6l5.6-5.6L5 6.4 6.4 5Z" fill="currentColor"/></svg>
      </button>
    </div>
    <div class="v-stage" data-v-stage>
      <img class="v-img" data-v-img alt="" decoding="async" />
    </div>
    <button type="button" class="v-btn v-nav v-prev" data-v-prev aria-label="Previous image">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M15.4 4.6 8 12l7.4 7.4-1.4 1.4L5.2 12l8.8-8.8 1.4 1.4Z" fill="currentColor"/></svg>
    </button>
    <button type="button" class="v-btn v-nav v-next" data-v-next aria-label="Next image">
      <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M8.6 4.6 16 12l-7.4 7.4 1.4 1.4 8.8-8.8L10 3.2 8.6 4.6Z" fill="currentColor"/></svg>
    </button>
  </dialog>
</section>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-viewer-dialog]');
  const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-viewer]')];
  if (dialog && triggers.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-v-img]')!;
    const title = dialog.querySelector<HTMLElement>('[data-v-title]')!;
    const pos = dialog.querySelector<HTMLElement>('[data-v-pos]')!;
    let index = 0;
    let opener: HTMLButtonElement | null = null;

    // Reuse the board's own responsive sources (no extra downloads up front); the browser picks the
    // largest candidate needed for the viewer size.
    const show = (i: number) => {
      index = (i + triggers.length) % triggers.length;
      const t = triggers[index]!;
      const src = t.querySelector('img')!;
      const w = Number(src.getAttribute('width')) || 4, h = Number(src.getAttribute('height')) || 3;
      const shown = Math.min(window.innerWidth * 0.94, (window.innerHeight - 120) * (w / h));
      img.removeAttribute('src');
      img.width = w; img.height = h;
      img.sizes = `${Math.round(shown)}px`;
      img.srcset = src.getAttribute('srcset') ?? '';
      img.src = src.getAttribute('src') ?? '';
      img.alt = src.alt;
      title.textContent = t.dataset.project ?? '';
      pos.textContent = t.dataset.pos ?? '';
    };
    const step = (d: number) => show(index + d);

    triggers.forEach((t, i) => t.addEventListener('click', () => {
      opener = t;
      show(i);
      document.documentElement.classList.add('viewer-open');
      dialog.showModal();
    }));
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('viewer-open');
      opener?.focus();
    });
    dialog.querySelector('[data-v-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-v-prev]')!.addEventListener('click', () => step(-1));
    dialog.querySelector('[data-v-next]')!.addEventListener('click', () => step(1));
    // Clicking the dimmed area around the image closes the viewer
    dialog.querySelector('[data-v-stage]')!.addEventListener('click', (e) => { if (e.target !== img) dialog.close(); });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    });

    let x0: number | null = null, y0 = 0;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0]!.clientX; y0 = e.touches[0]!.clientY; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0]!.clientX - x0, dy = e.changedTouches[0]!.clientY - y0;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      x0 = null;
    }, { passive: true });
  }
</script>

<style>
  .work { background: var(--paper); color: var(--ink); padding-block: clamp(40px, 5vw, 72px) clamp(64px, 8vw, 112px); }

  /* Chapter introduction — full portfolio width, compact */
  .chapter + .chapter { margin-top: clamp(56px, 7vw, 96px); }
  .chapter { scroll-margin-top: calc(var(--header-h) + 16px); }
  .chapter-head {
    padding-bottom: clamp(16px, 2vw, 24px); margin-bottom: clamp(24px, 3vw, 40px);
    border-bottom: 1px solid var(--rule-light);
  }
  .chapter-num { color: var(--blue); font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.24em; }
  .chapter-title {
    margin-top: 6px;
    font-size: clamp(1.75rem, 3.6vw, 3rem); font-weight: 800; line-height: 1.08; letter-spacing: -0.01em;
  }
  .deliv {
    list-style: none; margin: 12px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; row-gap: 2px;
    font-size: 0.9375rem; line-height: 1.6; color: var(--label);
  }
  /* Separator trails each item, so wrapped lines never start with a dot */
  .deliv li:not(:last-child)::after { content: '·'; margin-inline: 0.55em; color: var(--blue); }

  /* Projects: one per full-width row, a clear gap between projects */
  .projects { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 80px); }

  .project { scroll-margin-top: calc(var(--header-h) + 16px); }
  .project-head { margin-bottom: 12px; }
  .client { font-size: clamp(1.0625rem, 1.5vw, 1.25rem); font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1.25; }
  .ptitle { font-weight: 400; text-transform: none; letter-spacing: 0; color: var(--label); }
  .meta { margin-top: 4px; font-size: 0.75rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--value); }

  /* Boards inside a project: one column on phones, two per row from 760 px, in sequence */
  .boards { display: grid; grid-template-columns: minmax(0, 1fr); gap: 16px; align-items: start; }
  @media (min-width: 760px) {
    .boards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    /* Paired single-board projects: two project columns, each board one column wide */
    .pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; align-items: start; }
    .pair .boards { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 759px) { .pair { display: flex; flex-direction: column; gap: clamp(48px, 6vw, 80px); } }

  .board {
    position: relative; display: block; width: 100%; padding: 0; border: 0; background: none;
    cursor: zoom-in; overflow: hidden;
  }
  .board :global(img) {
    display: block; width: 100%; height: auto;
    box-shadow: inset 0 0 0 1px var(--rule-light);
    transition: transform 0.5s var(--ease), filter 0.3s var(--ease);
  }
  .zoom {
    position: absolute; top: 10px; right: 10px;
    display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%;
    background: rgb(0 0 4 / 0.72); color: var(--cream);
    opacity: 0; transform: scale(0.85);
    transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .board:hover :global(img) { transform: scale(1.015); }
  .board:hover .zoom, .board:focus-visible .zoom { opacity: 1; transform: none; }
  .board:focus-visible { outline-offset: 2px; }
  @media (hover: none) { .zoom { opacity: 0.85; transform: none; width: 28px; height: 28px; top: 8px; right: 8px; } }

  /* Viewer */
  :global(html.viewer-open) { overflow: hidden; }
  .viewer {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgb(0 0 4 / 0.72); color: var(--cream); overflow: hidden;
  }
  .viewer::backdrop { background: rgb(0 0 4 / 0.55); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
  .viewer[open] { display: grid; grid-template-rows: auto minmax(0, 1fr); }
  .v-bar {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 10px clamp(12px, 3vw, 32px); min-height: var(--header-h);
    background: var(--ink); border-bottom: 1px solid var(--rule-dark);
  }
  .v-info { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; min-width: 0; }
  .v-title { font-size: 0.875rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; }
  .v-pos { font-size: 0.8125rem; letter-spacing: 0.12em; color: var(--blue); font-weight: 800; }
  .v-stage { display: grid; place-items: center; padding: clamp(12px, 2vh, 24px) 3vw; min-height: 0; }
  .v-img {
    max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain;
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
  }
  .v-btn {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 1px solid var(--rule-dark); border-radius: 50%; background: rgb(0 0 4 / 0.6); color: var(--cream);
    cursor: pointer; transition: background-color 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .v-btn:hover { background: var(--blue); border-color: var(--blue); color: var(--ink); }
  .v-close { flex: none; }
  .v-nav { position: fixed; top: 50%; transform: translateY(-50%); width: 52px; height: 52px; }
  .v-prev { left: clamp(8px, 2vw, 28px); }
  .v-next { right: clamp(8px, 2vw, 28px); }
  @media (max-width: 760px) {
    .v-nav { top: auto; bottom: 16px; transform: none; width: 48px; height: 48px; }
    .v-stage { padding-bottom: 80px; }
  }
</style>
